                  RowBox[{"gridSize", "-", "i", "+", "1"}], "]"}], "]"}]}], 
               "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "gridSize", ",", "10"}], "}"}]}], 
             "]"}], ",", "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"xGrid", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "gridSize", ",", "10"}], "}"}]}], 
             "]"}], ",", "None"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
         "\"\<x (optical depth)\>\"", ",", 
          "\"\<\[Nu]0 (diffusion length)\>\""}], "}"}]}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "Full"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"pLog", "=", 
     RowBox[{"MatrixPlot", "[", 
      RowBox[{"dataLog", ",", 
       RowBox[{"ColorFunction", "\[Rule]", "\"\<TemperatureMap\>\""}], ",", 
