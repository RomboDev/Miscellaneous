Cell[CellGroupData[{

Cell["Attempt 2 -- corrected, explicit rewrite", "Section",ExpressionUUID->"852de19f-7db1-4dc9-a855-e0c757b907ae"],

Cell["\<\
Same derivation, cleaned up to use ExpIntegralE[1,x] explicitly throughout \
instead of relying on the Gamma[0,x] identity. Confirmed numerically to be \
byte-for-byte the same closed form as Attempt 1's ePDF/eCDF.\
\>", "Text",ExpressionUUID->"ea972810-abdf-4454-a69a-7eba4776cc59"],

Cell[CellGroupData[{

Cell["\<\
ClearAll[\"Global`*\"];

exitProbDist = E^(x + x/u)/(
  1 - E^x x ExpIntegralE[1, 
     x]);        
     
(* Subscript[E, 1] is the 'first exp integral' : the integral from 1 to \
Infinity of Exp[-x t]/t dt, like in the Milne equation *)
(* for the above, see d'Eon/Krivanek -> Zero-Variance Theory for Efficient \
Subsurface Scattering *)
(* mu domain is -1 to 0 as we're trying to reach the boundary so directions \
go upward *)
(* x > 0 as we're in medium seeking to escape *)
\[ScriptCapitalD] = 
 Simplify[ProbabilityDistribution[exitProbDist, {u, -1, 0}, 
   Assumptions -> x > 0, Method -> \"Normalize\"]]
\[ScriptCapitalD] /. 
 ProbabilityDistribution -> 
  Integrate (* let's check it integrates to 1 *)
CDF[\[ScriptCapitalD]] (* from PDF find the CDF *)\
\>", "Input",
 CellChangeTimes->{{3.9966600279107685`*^9, 3.996660029662964*^9}, {
  3.996660286205327*^9, 3.9966602877828455`*^9}},
 CellLabel->
  "In[238]:=",ExpressionUUID->"03ca7002-5916-489d-9e6a-788fd7d65802"],

Cell[BoxData[
 RowBox[{"ProbabilityDistribution", "[", 
  RowBox[{
   FractionBox[
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"x", "+", 
      FractionBox["x", "\[FormalX]"]}]], 
    RowBox[{"1", "-", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", "x"], " ", "x", " ", 
      RowBox[{"ExpIntegralE", "[", 
       RowBox[{"1", ",", "x"}], "]"}]}]}]], ",", 
   RowBox[{"{", 
    RowBox[{"\[FormalX]", ",", 
     RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"x", ">", "0"}]}]}], "]"}]], "Output",
 CellChangeTimes->{3.996339918198241*^9, 3.996659524966329*^9, 
  3.996661344094783*^9, 3.9966627877816863`*^9},
 CellLabel->
  "Out[246]=",ExpressionUUID->"497b4a61-36e6-4b13-a65a-2b923e95862d"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.996339918198241*^9, 3.996659524966329*^9, 
  3.996661344094783*^9, 3.9966627884626656`*^9},
 CellLabel->
  "Out[247]=",ExpressionUUID->"8c3318bd-98c4-413f-87d8-06b4ff64cd43"],

Cell[BoxData[
 RowBox[{"Function", "[", 
  RowBox[{"\[FormalX]", ",", 
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {"1", 
          RowBox[{"\[FormalX]", "\[GreaterEqual]", "0"}]},
         {
          FractionBox[
           RowBox[{
            RowBox[{"-", "1"}], "-", 
            RowBox[{"\[FormalX]", " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{"x", "+", 
               FractionBox["x", "\[FormalX]"]}]]}], "+", 
            RowBox[{
             SuperscriptBox["\[ExponentialE]", "x"], " ", "x", " ", 
             RowBox[{"Gamma", "[", 
              RowBox[{"0", ",", "x"}], "]"}]}], "-", 
            RowBox[{
             SuperscriptBox["\[ExponentialE]", "x"], " ", "x", " ", 
             RowBox[{"Gamma", "[", 
              RowBox[{"0", ",", 
               RowBox[{"-", 
                FractionBox["x", "\[FormalX]"]}]}], "]"}]}]}], 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            RowBox[{
             SuperscriptBox["\[ExponentialE]", "x"], " ", "x", " ", 
             RowBox[{"ExpIntegralE", "[", 
              RowBox[{"1", ",", "x"}], "]"}]}]}]], 
          RowBox[{
           RowBox[{"-", "1"}], "<", "\[FormalX]", "<", "0"}]},
         {"0", 
          TagBox["True",
           "PiecewiseDefault",
           AutoDelete->True]}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
        GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.84]}, 
            Offset[0.27999999999999997`]}, "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}},
        Selectable->True]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.35]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    "Piecewise",
    DeleteWithContents->True,
    Editable->False,
    SelectWithContents->True,
    Selectable->False,
    StripWrapperBoxes->True], ",", "Listable"}], "]"}]], "Output",
 CellChangeTimes->{3.996339918198241*^9, 3.996659524966329*^9, 
  3.996661344094783*^9, 3.9966627893136387`*^9},
 CellLabel->
  "Out[248]=",ExpressionUUID->"ab604f5e-181c-4ab1-88f9-fbaedaa3df26"]
}, Open  ]],

Cell["\<\
(* from above we have the following PDF and CDF *)
ePDFx[x_, u_] = E^(x + x/u)/(1 - E^x x ExpIntegralE[1, x]); 

eCDFx[x_, u_] = (-1 - u E^(x + x/u) + E^x x Gamma[0, x] - 
   E^x x Gamma[0, -(x/u)])/(-1 + 
   E^x x ExpIntegralE[1, 
     x]); 

(* Gamma here is the incomplete gamma function, Gamma(a,z) *)
(* Solve, NSolve, InverseCDF etc. miserably fail.. use root finding \
Newton-Raphson method for eCDF[x,u] - Xi *)
sampleExitDirX[x_] := Module[{\[Xi], n, u0, ux},
  \[Xi] = RandomReal[];
  n = 0;
  u0 = -1;
  While[n < 6, (* check this in real code, 4/5 iters may be enough *)
   ux = u0 - (eCDFx[x, u0] - \[Xi])/ePDFx[x, u0];
   u0 = ux;
   n++];
  u0]\
\>", "Input",
 CellChangeTimes->{{3.9966594232066393`*^9, 3.9966594295368586`*^9}},
 CellLabel->
  "In[249]:=",ExpressionUUID->"0fbe8a1a-ce5c-4606-8e7a-c32e7aa49d8c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", "0.15"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Histogram", "[", 
      RowBox[{
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"sampleExitDirX", "[", "x", "]"}], ",", 
         RowBox[{"{", 
