Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Monte", " ", "Carlo", " ", "Estimator", " ", "Variance", " ", 
    "Benchmark"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"TOP", ":", " ", 
    RowBox[{
     RowBox[{"Standard", " ", "deviation", " ", "error", " ", "map", " ", 
      RowBox[{"(", 
       RowBox[{"N", "=", "64"}], ")"}]}], "|", " ", "BOTTOM"}], ":", " ", 
    RowBox[{
     RowBox[{"Single", "-", 
      RowBox[{"sample", " ", 
       RowBox[{"(", 
        RowBox[{"N", "=", "1"}], ")"}], " ", "noise", " ", "output"}]}], "|", 
     RowBox[{"Bottom", ":"}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Note", ":", " ", 
     RowBox[{
     "Evaluates", " ", "STD", " ", "maps", " ", "and", " ", "raw", " ", 
      "noise", " ", 
      RowBox[{"(", 
       RowBox[{"N", "=", "1"}], ")"}], " ", "directly", " ", "instead", " ", 
      "of", " ", "spatial", " ", "means"}]}], ","}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Settings", " ", "to", " ", "exaggerate", " ", "noise", " ", 
    "differences"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nTrialsPerPixel", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Single", " ", "sample", " ", "per", " ", "pixel", " ", "highlights", " ",
      "estimator", " ", "variance", " ", "best"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freq", "=", "256"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gfFixed", "=", "0.75"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xMax", "=", "3.5"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "When", " ", "$", "\\n", "u_", "0", "$", " ", "approaches", " ", "1"}], 
     ",", 
     RowBox[{
      RowBox[{"the", " ", "Dwivedi", " ", "zero"}], "-", 
      RowBox[{
      "variance", " ", "directional", " ", "distribution", " ", "becomes", 
       " ", "significantly", " ", "more", " ", "forward"}], "-", "peaked"}], 
     ",", 
     RowBox[{
     "causing", " ", "standard", " ", "boundary", " ", "sampling", " ", "to", 
      " ", "suffer", " ", "from", " ", "massive", " ", "weight", " ", 
      "spikes", " ", "and", " ", "high", " ", "failure", " ", "rates", " ", 
      "when", " ", "attempting", " ", "to", " ", "escape"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"nu0Fixed", "=", "1.25"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Generate", " ", "raw", " ", "noisy", " ", "single"}], "-", 
     RowBox[{
     "sample", " ", "estimates", " ", "across", " ", "the", " ", "2", "D", 
      " ", "grid"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"standardNoiseData", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"standardContribution", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "/", "freq"}], ")"}], "*", "xMax"}], ",", "nu0Fixed", 
         ",", "gfFixed"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "freq"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "freq"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"resampledNoiseData", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"xVal", "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "/", "freq"}], ")"}], "*", "xMax"}]}], ",", 
           "Pesc"}], "}"}], ",", 
         RowBox[{
          RowBox[{"Pesc", "=", 
           RowBox[{"PescMix", "[", 
            RowBox[{"xVal", ",", "nu0Fixed", ",", "gfFixed"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"resampledContribution", "[", 
           RowBox[{"xVal", ",", "nu0Fixed", ",", "gfFixed", ",", "Pesc"}], 
           "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "freq"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "freq"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "Variance", " ", "Maps", " ", "over", " ", "64", " ", 
     "trials", " ", "per", " ", "pixel", " ", "to", " ", "visualize", " ", 
     "noise", " ", "reduction", " ", "directly"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"nVarianceTrials", "=", "64"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"standardVarData", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Variance", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"standardContribution", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "/", "freq"}], ")"}], "*", "xMax"}], ",", 
            "nu0Fixed", ",", "gfFixed"}], "]"}], ",", 
          RowBox[{"{", "nVarianceTrials", "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "32"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "32"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"resampledVarData", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"xVal", "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "/", "freq"}], ")"}], "*", "xMax"}]}], ",", 
           "Pesc"}], "}"}], ",", 
         RowBox[{
          RowBox[{"Pesc", "=", 
           RowBox[{"PescMix", "[", 
            RowBox[{"xVal", ",", "nu0Fixed", ",", "gfFixed"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Variance", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"resampledContribution", "[", 
              RowBox[{"xVal", ",", "nu0Fixed", ",", "gfFixed", ",", "Pesc"}], 
              "]"}], ",", 
             RowBox[{"{", "nVarianceTrials", "}"}]}], "]"}], "]"}]}]}], "]"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "32"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "32"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "Comparison"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"MatrixPlot", "[", 
        RowBox[{"standardVarData", ",", 
         RowBox[{"ColorFunction", "\[Rule]", "\"\<SunsetColors\>\""}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", "\"\<Standard Variance Map\>\""}]}], 
        "]"}], ",", 
