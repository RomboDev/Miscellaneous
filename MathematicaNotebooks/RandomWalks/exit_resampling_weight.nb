Cell["\<\
-- Interpreting results --

At \[Nu]\:2080=2 (strong guiding), the guided escape probability is more than \
double the classical one \[LongDash] 0.180 vs 0.074 \[LongDash] which is the \
whole point of guiding: at a small diffusion length, the walk is being \
steered hard toward the exit, so it\[CloseCurlyQuote]s genuinely far more \
likely to escape than a walk sampled blindly. As \[Nu]\:2080 climbs \
\[LongDash] 10, 100, 1000 \[LongDash] that gap shrinks steadily and \
monotonically, until at \[Nu]\:2080=1000 the two are within 0.17% of each \
other, essentially converged. PescClassical stays exactly constant across \
every row, as it should \[LongDash] it has no dependence on \[Nu]\:2080 at \
all, it\[CloseCurlyQuote]s purely a function of the classical (unguided) \
scheme.\
\>", "Text",
 CellChangeTimes->{{3.996661178582631*^9, 3.9966611834313345`*^9}, 
   3.996661275658495*^9, {3.9966635746010613`*^9, 3.996663588395582*^9}, {
   3.996663620789182*^9, 
   3.9966636282942133`*^9}},ExpressionUUID->"53eb581d-68cf-4a17-8832-\
a581dcdb24f4"],

Cell["\<\

==============================================================================\
===
-- SOME TESTS --\
\>", "Text",
 CellChangeTimes->{{3.825698548269848*^9, 3.825698552386524*^9}, {
  3.996663635758977*^9, 3.9966636465679283`*^9}, {3.996663907456531*^9, 
  3.9966639083607*^9}},ExpressionUUID->"088df9b9-7513-43b1-94b5-ec95989f8145"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Assumes", " ", "ePDFx"}], ",", "eCDFx", ",", "sampleExitDirX", 
    ",", "PescClassical", ",", "PescDwivedi", ",", 
    RowBox[{
    "PescMix", " ", "are", " ", "already", " ", "defined", " ", "above", " ", 
     "in", " ", "this", " ", "notebook", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"with", " ", 
        RowBox[{"the", "?", "NumericQ"}], " ", "guards"}], ")"}], "."}]}]}], 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"one", " ", "standard", " ", 
      RowBox[{"(", 
       RowBox[{"un", "-", "resampled"}], ")"}], " ", "last"}], "-", 
     RowBox[{"step", " ", "escape", " ", "contribution"}]}], ",", " ", 
    RowBox[{"at", " ", "depth", " ", 
     RowBox[{"x", "--"}], " ", "returns", " ", "0", " ", "on", " ", "any", 
     " ", "trial", " ", "that", " ", 
     RowBox[{"doesn", "'"}], "t", " ", "happen", " ", "to", " ", "escape", 
     " ", "this", " ", "step"}], ",", " ", 
    RowBox[{
    "exactly", " ", "like", " ", "a", " ", "real", " ", "walk", " ", "would", 
     " ", "score", " ", "it"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"standardContribution", "[", 
     RowBox[{
      RowBox[{"x_", "?", "NumericQ"}], ",", 
      RowBox[{"nu0_", "?", "NumericQ"}], ",", 
      RowBox[{"gf_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "guided", ",", "u", ",", "fwdPdfFactor", ",", "fwdStretch", ",", 
        "sampleSigmaT", ",", "t", ",", "xNew", ",", "hit", ",", "tEff", ",", 
        "pdfClassical", ",", "pdfDwivedi", ",", "pdfMix", ",", "trans", ",", 
        "phaseLog"}], "}"}], ",", 
      RowBox[{
       RowBox[{"phaseLog", "=", 
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"nu0", "+", "1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"nu0", "-", "1"}], ")"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"guided", "=", 
        RowBox[{
         RowBox[{"RandomReal", "[", "]"}], "<", "gf"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"u", "=", 
        RowBox[{"If", "[", 
         RowBox[{"guided", ",", 
          RowBox[{"-", 
           RowBox[{"(", 
            RowBox[{"nu0", "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"nu0", "+", "1"}], ")"}], " ", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"RandomReal", "[", "]"}]}], " ", "phaseLog"}], 
               "]"}]}]}], ")"}]}], ",", 
          RowBox[{
           RowBox[{"2", " ", 
            RowBox[{"RandomReal", "[", "]"}]}], "-", "1"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"fwdPdfFactor", "=", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"nu0", "+", "u"}], ")"}], " ", "phaseLog"}], ")"}]}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"fwdStretch", "=", 
        RowBox[{"1", "+", 
         RowBox[{"u", "/", "nu0"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sampleSigmaT", "=", 
        RowBox[{"If", "[", 
         RowBox[{"guided", ",", "fwdStretch", ",", "1"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"t", "=", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Log", "[", 
           RowBox[{"1", "-", 
            RowBox[{"RandomReal", "[", "]"}]}], "]"}]}], "/", 
         "sampleSigmaT"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xNew", "=", 
        RowBox[{"x", "+", 
         RowBox[{"t", "*", "u"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"hit", "=", 
        RowBox[{
         RowBox[{"xNew", "<", "0"}], "&&", 
         RowBox[{"u", "<", 
          RowBox[{"-", 
           RowBox[{"10", "^", 
            RowBox[{"-", "9"}]}]}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", "hit"}], ",", 
         RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tEff", "=", 
        RowBox[{
         RowBox[{"-", "x"}], "/", "u"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pdfClassical", "=", 
        RowBox[{"0.5", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "tEff"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pdfDwivedi", "=", 
        RowBox[{"fwdPdfFactor", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "fwdStretch"}], " ", "tEff"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pdfMix", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "gf"}], ")"}], " ", "pdfClassical"}], "+", 
         RowBox[{"gf", " ", "pdfDwivedi"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"trans", "=", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", "tEff"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"trans", "/", "pdfMix"}]}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"one", " ", "resampled", " ", "last"}], "-", 
      RowBox[{"step", " ", 
       RowBox[{"contribution", "--"}], " ", "Pesc", " ", "is", " ", 
       "precomputed", " ", "OUTSIDE", " ", "any", " ", "per"}], "-", 
      RowBox[{"pixel", " ", "loop"}]}], ",", 
     RowBox[{"since", " ", 
      RowBox[{"it", "'"}], "s", " ", "a", " ", "real", " ", "numeric", " ", 
      "integral", " ", "and", " ", 
      RowBox[{"shouldn", "'"}], "t", " ", "be", " ", "recomputed", " ", "on", 
      " ", "every", " ", "single", " ", "trial"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resampledContribution", "[", 
     RowBox[{
      RowBox[{"x_", "?", "NumericQ"}], ",", 
      RowBox[{"nu0_", "?", "NumericQ"}], ",", 
      RowBox[{"gf_", "?", "NumericQ"}], ",", 
      RowBox[{"Pesc_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"uR", ",", "tR", ",", "transR", ",", "pdfR"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"RandomReal", "[", "]"}], "\[GreaterEqual]", "Pesc"}], ",", 
         RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"uR", "=", 
        RowBox[{"sampleExitDirX", "[", "x", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tR", "=", 
        RowBox[{
         RowBox[{"-", "x"}], "/", "uR"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"transR", "=", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", "tR"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"pdfR", "=", 
        RowBox[{"ePDFx", "[", 
         RowBox[{"x", ",", "uR"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"transR", "/", 
        RowBox[{"(", 
         RowBox[{"pdfR", "*", "Pesc"}], ")"}]}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"per", "-", 
     RowBox[{"pixel", ":", "average"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nTrialsPerPixel", "=", "8"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"freq", "=", "256"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nu0Fixed", "=", "2.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gfFixed", "=", "0.75"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xMax", "=", "2.5"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "depth", " ", "swept", " ", "across", " ", "image", " ", "width"}], 
    "*)"}], 
   RowBox[{
    RowBox[{"standardPanel", "[", "i_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"i", "/", "freq"}], ")"}], "*", "xMax"}]}], "}"}], ",", 
      RowBox[{"Mean", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"standardContribution", "[", 
          RowBox[{"x", ",", "nu0Fixed", ",", "gfFixed"}], "]"}], ",", 
         RowBox[{"{", "nTrialsPerPixel", "}"}]}], "]"}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"resampledPanel", "[", "i_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"i", "/", "freq"}], ")"}], "*", "xMax"}]}], ",", "Pesc"}], 
       "}"}], ",", 
      RowBox[{
       RowBox[{"Pesc", "=", 
        RowBox[{"PescMix", "[", 
         RowBox[{"x", ",", "nu0Fixed", ",", "gfFixed"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Mean", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"resampledContribution", "[", 
           RowBox[{"x", ",", "nu0Fixed", ",", "gfFixed", ",", "Pesc"}], "]"}],
           ",", 
          RowBox[{"{", "nTrialsPerPixel", "}"}]}], "]"}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"standardData", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"standardPanel", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "freq"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "freq"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resampledData", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"resampledPanel", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "freq"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "freq"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"MatrixPlot", "[", 
        RowBox[{"standardData", ",", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], ",", 
         RowBox[{"ColorFunctionScaling", "\[Rule]", "True"}], ",", 
         RowBox[{"Frame", "\[Rule]", "False"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "Medium"}], ",", 
         RowBox[{
         "PlotLabel", "\[Rule]", "\"\<Standard (un-resampled)\>\""}]}], "]"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"MatrixPlot", "[", 
        RowBox[{"resampledData", ",", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], ",", 
         RowBox[{"ColorFunctionScaling", "\[Rule]", "True"}], ",", 
         RowBox[{"Frame", "\[Rule]", "False"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "Medium"}], ",", 
         RowBox[{"PlotLabel", "\[Rule]", "\"\<Exit-resampled\>\""}]}], 
        "]"}]}], "}"}], "}"}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"ain", "'"}], "t", " ", "gonna", " ", "work", " ", "pretty", 
      " ", "well", " ", "because", " ", 
      RowBox[{"we", "'"}], "re", " ", "using", " ", "Mean", " ", "and", " ", 
      "that", " ", "averages", " ", "out", " ", "the", " ", "stochastic", " ",
       "noise", " ", "across", " ", "the", " ", "pixel", " ", "rows"}], ",", 
     RowBox[{
     "and", " ", "smooth", " ", "1", "D", " ", "depth", " ", "gradients", " ",
       "hide", " ", "variance", " ", "differences", " ", "extremely", " ", 
      RowBox[{"well", "."}]}]}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.9966626957617674`*^9, 3.9966626957617674`*^9}, {
  3.99666274752034*^9, 3.9966627483841105`*^9}, {3.996662853777279*^9, 
