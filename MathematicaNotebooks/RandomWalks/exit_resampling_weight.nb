       RowBox[{"ImageSize", "\[Rule]", "Full"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pLinear", ",", "pLog"}], "}"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "Full"}]}], "]"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Top", "/", "Blue"}], " ", "area", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"$", "\\n", "u_", "0"}], ">", 
        RowBox[{"3", "$"}]}], ")"}]}], ":", 
     RowBox[{"Near", "-", 
      RowBox[{"isotropic", " ", "regime", " ", "where", " ", "exit"}], "-", 
      RowBox[{"resampling", " ", "provides", " ", "modest", " ", "gains", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"$", "\\", "sim"}], " ", 
          RowBox[{
           RowBox[{"1", "\\%"}], "\\", "text"}], 
          RowBox[{"{", "--", "}"}], 
          RowBox[{"10", "\\%", "$"}]}], ")"}], "."}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Bottom", "/", "Red"}], " ", "boundary", " ", 
      RowBox[{"(", 
       RowBox[{"$", "\\n", "u_", 
        RowBox[{"0", "\\", "to"}], " ", "1", "$"}], ")"}]}], ":", 
     RowBox[{
     "Highly", " ", "anisotropic", " ", "regime", " ", "where", " ", 
      "standard", " ", "sampling", " ", "breaks", " ", "down"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Resolution", " ", "of", " ", "the", " ", "2", "D", " ", "grid"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xGrid", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{
       RowBox[{"xRange", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"xRange", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", "gridSize"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"nu0Grid", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{
       RowBox[{"nu0Range", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"nu0Range", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", "gridSize"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Fast", " ", "parallel", " ", "computation", " ", "over", " ", "the", " ",
      "2", "D", " ", "grid"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataLinear", "=", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"vStd", "=", 
            RowBox[{"VarStandardFast", "[", 
             RowBox[{"x", ",", "nu0", ",", "gfFixed"}], "]"}]}], ",", 
           RowBox[{"vRes", "=", 
            RowBox[{"VarResampled", "[", 
             RowBox[{"x", ",", "nu0", ",", "gfFixed"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"vRes", ">", "0"}], ",", 
           RowBox[{"vStd", "/", "vRes"}], ",", "1.0"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"nu0", ",", 
         RowBox[{"Reverse", "[", "nu0Grid", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "xGrid"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"dataLog", "=", 
     RowBox[{"Log10", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"1.0", ",", "#"}], "]"}], "&"}], ",", "dataLinear", ",", 
        RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Display", " ", "side"}], "-", "by", "-", 
     RowBox[{"side", " ", "using", " ", "full", " ", "width"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pLinear", "=", 
     RowBox[{"MatrixPlot", "[", 
      RowBox[{"dataLinear", ",", 
