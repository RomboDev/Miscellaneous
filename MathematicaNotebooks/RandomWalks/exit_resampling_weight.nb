Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"n", ",", "rr"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "10000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rr", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"RandomReal", "[", "]"}], ",", 
      RowBox[{"{", "n", "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"eitx", "=", 
  RowBox[{
   RowBox[{"Power", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{"ExpIntegralE", "[", 
       RowBox[{"1", ",", "rr"}], "]"}], "]"}], ",", "2"}], "]"}], "/", 
   "n"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eit", "=", 
   RowBox[{
    RowBox[{"Power", "[", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"E1", "/@", "rr"}], "]"}], ",", "2"}], "]"}], "/", "n"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Quantity", "[", 
  RowBox[{
   RowBox[{"100", "*", 
    RowBox[{"Abs", "[", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"%%", "/", "%"}], ")"}], "2"], "-", "1"}], ")"}], "]"}]}], 
   ",", "\"\<Percent\>\""}], "]"}]}], "Input",
