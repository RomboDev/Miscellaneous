Cell["\<\
With the above  .. substitute both Gamma and E1 with our approximations\
\>", "Text",
 CellChangeTimes->{{3.8285300954517736`*^9, 3.8285301241155863`*^9}, {
  3.867239505651018*^9, 
  3.8672395131233625`*^9}},ExpressionUUID->"77921666-28f4-4c3e-a919-\
a518f9955c8f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ePDFxx", "[", 
     RowBox[{"x_", ",", "u_"}], "]"}], " ", "=", " ", 
    FractionBox[
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"x", "+", 
       FractionBox["x", "u"]}]], 
     RowBox[{"1", "-", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", "x"], " ", "x", " ", 
       RowBox[{"E1", "[", "x", "]"}]}]}]]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"d", "'"}], 
    RowBox[{"Eon", "'"}], "s", " ", "exit", " ", "resampling"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eCDFxx", "[", 
     RowBox[{"x_", ",", "u_"}], "]"}], " ", "=", " ", 
    FractionBox[
     RowBox[{
      RowBox[{"-", "1"}], "-", 
      RowBox[{"u", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"x", "+", 
         FractionBox["x", "u"]}]]}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", "x"], " ", "x", " ", 
       RowBox[{"E1", "[", "x", "]"}]}], "-", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", "x"], " ", "x", " ", 
       RowBox[{"E1", "[", 
        RowBox[{"-", 
         FractionBox["x", "u"]}], "]"}]}]}], 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", "x"], " ", "x", " ", 
       RowBox[{"E1", "[", "x", "]"}]}]}]]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Use", " ", "root", " ", "finding", " ", "Newton"}], "-", 
    RowBox[{"Raphson", " ", "mtd", " ", "for", " ", 
     RowBox[{"eCDF", "[", 
      RowBox[{"x", ",", "u"}], "]"}]}], " ", "-", "\[Xi]"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sampleExitDirXX", "[", "x_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Xi]", ",", "n", ",", " ", "u0", ",", "ux"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Xi]", "=", 
       RowBox[{"RandomReal", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"u0", "=", 
       RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"n", "<", "6"}], ",", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"check", " ", "this", " ", "in", " ", "real", " ", "code"}],
           ",", " ", 
          RowBox[{
           RowBox[{"4", "/", "5"}], " ", "iters", " ", "may", " ", "be", " ", 
           "enough"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ux", "=", 
          RowBox[{"u0", "-", 
           FractionBox[
            RowBox[{
             RowBox[{"eCDFxx", "[", 
              RowBox[{"x", ",", "u0"}], "]"}], "-", "\[Xi]"}], 
            RowBox[{"ePDFxx", "[", 
             RowBox[{"x", ",", "u0"}], "]"}]]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"u0", "=", "ux"}], ";", "\[IndentingNewLine]", 
         RowBox[{"n", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", "u0"}]}],
     "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", "0.15"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Histogram", "[", 
      RowBox[{
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"sampleExitDirXX", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Range", "[", 
            RowBox[{"10", "^", "5"}], "]"}]}], "}"}]}], "]"}], ",", 
       "Automatic", ",", "\"\<PDF\>\"", ",", 
       RowBox[{"PlotTheme", "\[Rule]", "\"\<WarmColor\>\""}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"ePDFxx", "[", 
        RowBox[{"x", ",", "u"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", 
         RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Green", ",", " ", 
          RowBox[{"Opacity", "[", "0.75", "]"}]}], "}"}]}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.828529830517951*^9, 3.8285299066556463`*^9}, {
   3.828529947044262*^9, 3.828529967136661*^9}, 3.828530043209655*^9, {
   3.8285300801578207`*^9, 3.828530089177546*^9}, 3.82853015634065*^9, {
