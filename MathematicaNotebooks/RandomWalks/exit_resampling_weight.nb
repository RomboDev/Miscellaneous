     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xGrid", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{
       RowBox[{"xRange", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"xRange", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", "gridSize"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
