   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Closed", " ", 
     RowBox[{"form", " ", "--"}], " ", "exact"}], ",", " ", 
    RowBox[{"no", " ", "integration", " ", "needed"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "This", " ", "is", " ", "because", " ", "the", " ", "resampled", " ", 
     "direction", " ", "sampler", " ", "is", " ", "EXACTLY", " ", "zero"}], 
    "-", 
    RowBox[{"variance", " ", "conditional", " ", "on", " ", "escape", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"verified", ":", " ", 
        RowBox[{"trans", 
         RowBox[{
          RowBox[{"(", "u", ")"}], "/", "ePDFx"}], 
         RowBox[{"(", 
          RowBox[{"x", ",", "u"}], ")"}], " ", "is", " ", "constant", " ", 
         "in", " ", "u"}]}], ",", 
       RowBox[{
        RowBox[{"to", " ", "15"}], "+", "digits"}]}], ")"}]}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Every", " ", "bit", " ", "of", " ", "remaining", " ", "variance", " ", 
      "comes", " ", "from", " ", "the", " ", "Bernoulli", " ", "escape", " ", 
      "gate", " ", "alone"}], ".."}], " ", "does", " ", "the", " ", "ray", 
    " ", "escape", " ", "or", " ", "get", " ", 
    RowBox[{"absorbed", "/", "scattered"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"VarResampled", "[", 
