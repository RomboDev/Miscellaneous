             RowBox[{"Gamma", "[", 
              RowBox[{"0", ",", 
               RowBox[{"-", 
                FractionBox["x", "\[FormalX]"]}]}], "]"}]}]}], 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            RowBox[{
             SuperscriptBox["\[ExponentialE]", "x"], " ", "x", " ", 
             RowBox[{"Gamma", "[", 
              RowBox[{"0", ",", "x"}], "]"}]}]}]], 
          RowBox[{
           RowBox[{"-", "1"}], "<", "\[FormalX]", "<", "0"}]},
         {"0", 
          TagBox["True",
           "PiecewiseDefault",
           AutoDelete->True]}
        },
        AllowedDimensions->{2, Automatic},
