Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Assumes", " ", "ePDFx"}], ",", "PescClassical", ",", 
    "PescDwivedi", ",", 
    RowBox[{"PescMix", " ", "are", " ", "defined", " ", "above"}]}], " ", 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Closed", " ", 
     RowBox[{"form", " ", "--"}], " ", "exact"}], ",", " ", 
    RowBox[{"no", " ", "integration", " ", "needed"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "This", " ", "is", " ", "because", " ", "the", " ", "resampled", " ", 
     "direction", " ", "sampler", " ", "is", " ", "EXACTLY", " ", "zero"}], 
    "-", 
    RowBox[{"variance", " ", "conditional", " ", "on", " ", "escape", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"verified", ":", " ", 
        RowBox[{"trans", 
         RowBox[{
          RowBox[{"(", "u", ")"}], "/", "ePDFx"}], 
         RowBox[{"(", 
          RowBox[{"x", ",", "u"}], ")"}], " ", "is", " ", "constant", " ", 
         "in", " ", "u"}]}], ",", 
       RowBox[{
        RowBox[{"to", " ", "15"}], "+", "digits"}]}], ")"}]}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Every", " ", "bit", " ", "of", " ", "remaining", " ", "variance", " ", 
      "comes", " ", "from", " ", "the", " ", "Bernoulli", " ", "escape", " ", 
      "gate", " ", "alone"}], ".."}], " ", "does", " ", "the", " ", "ray", 
    " ", "escape", " ", "or", " ", "get", " ", 
    RowBox[{"absorbed", "/", "scattered"}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"VarResampled", "[", 
     RowBox[{
      RowBox[{"x_", "?", "NumericQ"}], ",", 
      RowBox[{"nu0_", "?", "NumericQ"}], ",", 
      RowBox[{"gf_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"phaseLog", ",", "Pesc"}], "}"}], ",", 
      RowBox[{
       RowBox[{"phaseLog", "=", 
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"nu0", "+", "1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"nu0", "-", "1"}], ")"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Pesc", "=", 
        RowBox[{"PescMix", "[", 
         RowBox[{"x", ",", "nu0", ",", "gf"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"ExpIntegralE", "[", 
          RowBox[{"2", ",", "x"}], "]"}], "^", "2"}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "Pesc"}], ")"}], "/", "Pesc"}]}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"the", " ", "standard", " ", 
      RowBox[{"scheme", "'"}], "s", " ", "variance"}], ",", 
     RowBox[{
     "via", " ", "direct", " ", "integration", " ", "over", " ", "the", " ", 
      "escaping", " ", 
      RowBox[{"directions", "--"}], " ", "given", " ", "u"}], ",", 
     RowBox[{
     "the", " ", "scored", " ", "value", " ", "on", " ", "escape", " ", "is", 
      " ", "deterministic"}], ",", 
     RowBox[{
      RowBox[{
      "so", " ", "only", " ", "\"\<which u, which branch, did it escape\>\"", 
       " ", "is", " ", "random"}], ";", 
      RowBox[{
      "that", " ", "lets", " ", "mean", " ", "and", " ", "second", " ", 
       "moment", " ", "reduce", " ", "to", " ", "plain", " ", "1", "D", " ", 
       "integrals", " ", "over", " ", "u", " ", "instead", " ", "of", " ", 
       "a", " ", "full", " ", 
       RowBox[{"(", 
        RowBox[{"branch", ",", "u", ",", "t"}], ")"}], " ", 
       "simulation"}]}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"VarStandard", "[", 
       RowBox[{
        RowBox[{"x_", "?", "NumericQ"}], ",", 
        RowBox[{"nu0_", "?", "NumericQ"}], ",", 
        RowBox[{"gf_", "?", "NumericQ"}]}], "]"}], ":=", 
      RowBox[{
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "phaseLog", ",", "pdfMixAtU", ",", "valueAtU", ",", 
            "escProbClassical", ",", "escProbDwivedi", ",", "mean", ",", 
            "second"}], "}"}], ",", 
          RowBox[{
           RowBox[{"phaseLog", "=", 
            RowBox[{"Log", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"nu0", "+", "1"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"nu0", "-", "1"}], ")"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"pdfMixAtU", "[", "u_", "]"}], ":=", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"tEff", "=", 
                 RowBox[{
                  RowBox[{"-", "x"}], "/", "u"}]}], ",", 
                RowBox[{"fwdStretch", "=", 
                 RowBox[{"1", "+", 
                  RowBox[{"u", "/", "nu0"}]}]}]}], "}"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "gf"}], ")"}], "*", "0.5", "*", 
                RowBox[{"Exp", "[", 
                 RowBox[{"-", "tEff"}], "]"}]}], "+", 
               RowBox[{"gf", "*", 
                RowBox[{"(", 
                 RowBox[{"1", "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"nu0", "+", "u"}], ")"}], " ", "phaseLog"}], 
                   ")"}]}], ")"}], "*", 
                RowBox[{"Exp", "[", 
                 RowBox[{
                  RowBox[{"-", "fwdStretch"}], " ", "tEff"}], "]"}]}]}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"valueAtU", "[", "u_", "]"}], ":=", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"x", "/", "u"}], "]"}], "/", 
             RowBox[{"pdfMixAtU", "[", "u", "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"escProbClassical", "[", "u_", "]"}], ":=", 
            RowBox[{"Exp", "[", 
             RowBox[{"x", "/", "u"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"escProbDwivedi", "[", "u_", "]"}], ":=", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"u", "/", "nu0"}]}], ")"}], " ", 
              RowBox[{"x", "/", "u"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"mean", "=", 
            RowBox[{"NIntegrate", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "gf"}], ")"}], "*", "0.5", "*", 
