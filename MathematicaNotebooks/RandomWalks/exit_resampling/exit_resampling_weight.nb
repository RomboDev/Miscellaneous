Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "=", "0.15"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Histogram", "[", 
      RowBox[{
       RowBox[{"ParallelTable", "[", 
        RowBox[{
         RowBox[{"sampleExitDir", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Range", "[", 
            RowBox[{"10", "^", "6"}], "]"}]}], "}"}]}], "]"}], ",", "256", 
       ",", "\"\<PDF\>\"", ",", 
       RowBox[{"PlotTheme", "\[Rule]", "\"\<WarmColor\>\""}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
