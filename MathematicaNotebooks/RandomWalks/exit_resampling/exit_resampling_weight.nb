                    RowBox[{"(", 
                    RowBox[{"nu0", "+", "u"}], ")"}], " ", "phaseLog"}], 
                   ")"}]}], ")"}], "*", 
                RowBox[{"escProbDwivedi", "[", "u", "]"}], "*", 
                RowBox[{"valueAtU", "[", "u", "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"u", ",", 
                RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
              RowBox[{"Method", "\[Rule]", "\"\<GaussKronrodRule\>\""}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"second", "=", 
            RowBox[{"NIntegrate", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", "gf"}], ")"}], "*", "0.5", "*", 
                RowBox[{"escProbClassical", "[", "u", "]"}], "*", 
                RowBox[{
                 RowBox[{"valueAtU", "[", "u", "]"}], "^", "2"}]}], "+", 
               RowBox[{"gf", "*", 
                RowBox[{"(", 
                 RowBox[{"1", "/", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"nu0", "+", "u"}], ")"}], " ", "phaseLog"}], 
                   ")"}]}], ")"}], "*", 
                RowBox[{"escProbDwivedi", "[", "u", "]"}], "*", 
                RowBox[{
                 RowBox[{"valueAtU", "[", "u", "]"}], "^", "2"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"u", ",", 
                RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
              RowBox[{"Method", "\[Rule]", "\"\<GaussKronrodRule\>\""}]}], 
             "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"second", "-", 
            RowBox[{"mean", "^", "2"}]}]}]}], "]"}], "\n", 
        "\[IndentingNewLine]", 
        RowBox[{"varianceRatio", "[", 
         RowBox[{
          RowBox[{"x_", "?", "NumericQ"}], ",", 
          RowBox[{"nu0_", "?", "NumericQ"}], ",", 
          RowBox[{"gf_", "?", "NumericQ"}]}], "]"}]}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"VarStandard", "[", 
           RowBox[{"x", ",", "nu0", ",", "gf"}], "]"}], "/", 
          RowBox[{"VarResampled", "[", 
           RowBox[{"x", ",", "nu0", ",", "gf"}], "]"}]}], "\n", 
         "\[IndentingNewLine]", "gfFixed"}], "=", "0.75"}]}]}], ";"}], 
    "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
