Cell[CellGroupData[{

Cell["\<\
Dwivedi-guided escape probability -- closed form (and quadrature)\
\>", "Subsection",
 CellChangeTimes->{{3.996767097340376*^9, 
  3.9967671088860426`*^9}},ExpressionUUID->"fd81ec94-d4e2-42ec-a2e1-\
cf076e810571"],

Cell[TextData[{
 "Originally computed via NIntegrate (Gauss-Kronrod quadrature). However ..  \
substituting w = -1/u (same substitution PescClassical uses) and \
partial-fractioning the resulting 1/(w(nu0 w - 1)) term reduces the integral \
to a combination of two E1 evaluations.\[LineSeparator]\[LineSeparator]Same \
u-convention as exitProbDist/ePDFx above (u<0 = toward escape). nu0 is the \
Dwivedi diffusion length; phaseLog = Log[(nu0+1)/(nu0-1)]. The guided \
direction density (normalized on u in [-1,1]) is 1/((nu0+u) phaseLog); the \
guided distance-stretching factor for direction u is (1+u/nu0); the geometric \
distance to the boundary from depth x along direction u is -x/u. This was \
derived independently in the code's own (opposite-sign) convention and \
confirmed to match this notebook-convention version exactly, numerically, \
before being trusted.\[LineSeparator]\n",
 StyleBox["Re-cap :\[LineSeparator]",
  FontVariations->{"Underline"->True}],
 "\[LineSeparator]",
 StyleBox["nu0",
  FontWeight->"Bold"],
 " :: scalar diffusion length, one value per walk (or per bounce-decision, \
computed from albedo).\[LineSeparator]",
 StyleBox["u",
  FontWeight->"Bold"],
 " :: the sampled direction cosine, the variable being drawn.\[LineSeparator]",
 StyleBox["phaseLog = Log[(nu0+1)/(nu0-1)]",
  FontWeight->"Bold"],
 " :: the normalization constant for the direction density.\[LineSeparator]",
 StyleBox["(1+u/nu0)",
  FontWeight->"Bold"],
 " :: the distance-stretching factor.\[LineSeparator]",
 StyleBox["-x/u",
  FontWeight->"Bold"],
 " :: distance-to-boundary.. u<0 = toward escape and x>0 = depth"
}], "Text",
 CellChangeTimes->{{3.9967659369627943`*^9, 3.9967659560162754`*^9}, {
  3.996765994568232*^9, 3.9967660921054716`*^9}, {3.9967661891705575`*^9, 
  3.9967661979553275`*^9}, {3.996766303172044*^9, 3.9967663246700706`*^9}, {
  3.9967664372404346`*^9, 3.9967664528826675`*^9}, {3.996767125167986*^9, 
  3.9967671635956764`*^9}, {3.9967672263448462`*^9, 3.9967672271612873`*^9}, {
  3.9967684343108077`*^9, 
  3.9967684353518085`*^9}},ExpressionUUID->"91d60621-2afe-4bde-bbfc-\
9c6a548979e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"closed", " ", 
      RowBox[{"form", "--"}], " ", "derived", " ", "via", " ", "w"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"-", "1"}], "/", "u"}], " ", "substitution"}], "+", 
       RowBox[{"partial", " ", "fractions", " ", "on", " ", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"w", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"nu0", " ", "w"}], "-", "1"}], ")"}]}], ")"}]}]}]}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "w"}], "+", 
       RowBox[{"nu0", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"nu0", " ", "w"}], "-", "1"}], ")"}]}]}]}]}], ",", 
    RowBox[{
    "each", " ", "piece", " ", "a", " ", "standard", " ", "E1", " ", 
     "integral"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"PescDwivedi", "[", 
     RowBox[{
      RowBox[{"x_", "?", "NumericQ"}], ",", 
      RowBox[{"nu0_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"phaseLog", ",", 
        RowBox[{"xn", "=", 
         RowBox[{"N", "[", "x", "]"}]}], ",", 
        RowBox[{"nu0n", "=", 
         RowBox[{"N", "[", "nu0", "]"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"phaseLog", "=", 
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"nu0n", "+", "1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"nu0n", "-", "1"}], ")"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "phaseLog"}], ")"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{"xn", "/", "nu0n"}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"ExpIntegralE", "[", 
            RowBox[{"1", ",", "xn"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "xn"}], "/", "nu0n"}], "]"}], "*", 
           RowBox[{"ExpIntegralE", "[", 
            RowBox[{"1", ",", 
             RowBox[{"xn", "*", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"nu0n", "-", "1"}], ")"}], "/", "nu0n"}]}]}], 
            "]"}]}]}], ")"}]}]}]}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"kept", " ", "for", " ", "cross"}], "-", 
      RowBox[{
      "checking", " ", "against", " ", "the", " ", "closed", " ", "form", " ",
        "above"}]}], ",", " ", 
     RowBox[{"not", " ", "because", " ", 
      RowBox[{"it", "'"}], "s", " ", "needed"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"PescDwivediQuadrature", "[", 
     RowBox[{
      RowBox[{"x_", "?", "NumericQ"}], ",", 
      RowBox[{"nu0_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"phaseLog", ",", 
        RowBox[{"xn", "=", 
         RowBox[{"N", "[", "x", "]"}]}], ",", 
        RowBox[{"nu0n", "=", 
         RowBox[{"N", "[", "nu0", "]"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"phaseLog", "=", 
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"nu0n", "+", "1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"nu0n", "-", "1"}], ")"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"NIntegrate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"nu0n", "+", "u"}], ")"}], " ", "phaseLog"}], ")"}]}], 
           ")"}], "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"xn", "/", "u"}], "+", 
            RowBox[{"xn", "/", "nu0n"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"u", ",", 
           RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
         RowBox[{"Method", "\[Rule]", "\"\<GaussKronrodRule\>\""}]}], 
        "]"}]}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"sanity", " ", 
      RowBox[{"check", ":", 
       RowBox[{
       "both", " ", "should", " ", "agree", " ", "to", " ", "within", " ", 
        RowBox[{"NIntegrate", "'"}], "s", " ", "own", " ", "quadrature", " ", 
        RowBox[{"precision", ".", " ", "Note"}]}], ":", 
       RowBox[{"at", " ", "machine", " ", "precision"}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"NIntegrate", "'"}], "s", " ", "own", " ", "error", " ", "is", 
       " ", 
       RowBox[{"typically", "~", "1"}], "e"}], "-", 
      RowBox[{"10", " ", "to", " ", "1", "e"}], "-", 
      RowBox[{"14", " ", "for", " ", "a", " ", "well"}], "-", 
      RowBox[{"behaved", " ", "integrand", " ", "like", " ", 
       RowBox[{"this", "--"}], " ", "much", " ", "looser", " ", "than", " ", 
       "the", " ", "closed", " ", 
       RowBox[{"form", "'"}], "s", " ", "near"}], "-", 
      RowBox[{"exact", " ", "accuracy"}]}], ",", 
     RowBox[{
     "so", " ", "the", " ", "tolerance", " ", "below", " ", "reflects", " ", 
      RowBox[{"NIntegrate", "'"}], "s", " ", "limit"}], ",", 
     RowBox[{"not", " ", "the", " ", "closed", " ", 
      RowBox[{"form", "'"}], 
      RowBox[{"s", "."}]}]}], "*)"}], 
   RowBox[{
    RowBox[{"tol", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "8"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"diff", "=", 
          RowBox[{
           RowBox[{"PescDwivedi", "[", 
            RowBox[{"x", ",", "nu0"}], "]"}], "-", 
           RowBox[{"PescDwivediQuadrature", "[", 
            RowBox[{"x", ",", "nu0"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "nu0", ",", "diff", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "diff", "]"}], "<", "tol"}], ",", 
            "\"\<PASSED\>\"", ",", "\"\<FAILED\>\""}], "]"}]}], "}"}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"{", 
         RowBox[{"0.2", ",", "1.0", ",", "2.0", ",", "5.0"}], "}"}]}], "}"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"nu0", ",", 
        RowBox[{"{", 
         RowBox[{"1.5", ",", "2.0", ",", "5.0", ",", "10.0"}], "}"}]}], 
       "}"}]}], "]"}], "//", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"#", ",", "1"}], "]"}], "&"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"NOTE", "::", " ", "initial"}], ",", " ", "validated", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"C", "++"}], " ", "code", " ", "used", " ", "a", " ", "fixed", 
       " ", "16"}], "-", 
      RowBox[{"node", " ", "Gauss"}], "-", 
      RowBox[{"Legendre", " ", "quadrature"}]}], ",", " ", 
     RowBox[{
      RowBox[{"hardcoded", " ", "as", " ", "a", " ", "constant", " ", 
       RowBox[{"node", "/", "weight"}], " ", "table", " ", 
       RowBox[{"on", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "]"}], " ", "evaluated", " ", "as", 
       " ", "a", " ", "plain", " ", "unrolled", " ", "16"}], "-", 
      RowBox[{"term", " ", "sum"}]}]}], " ", "*)"}]}]}]], "Input",
