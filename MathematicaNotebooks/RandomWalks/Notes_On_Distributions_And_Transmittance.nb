Cell["\<\

If we consider s as a random variable, we have : \
\>", "Text",
 CellChangeTimes->{{3.82716447745634*^9, 
  3.827164502184053*^9}},ExpressionUUID->"89211a16-fb79-442f-8118-\
52107e111203"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalTau]", "a"], 
    RowBox[{"(", "s", ")"}]}], "=", 
   RowBox[{
    RowBox[{"Pr", 
     RowBox[{"{", 
      RowBox[{"step", ">", "s"}], "}"}]}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "s", "\[Infinity]"], 
     RowBox[{
      SubscriptBox["p", "a"], 
      RowBox[{"(", "s", ")"}], 
      RowBox[{"\[DifferentialD]", "s"}]}]}]}]}],
  FontSize->18,
  FontColor->RGBColor[0.6, 0.4, 0.2]]], "DisplayFormula",
 CellChangeTimes->{{3.827164519013728*^9, 
  3.8271645575794353`*^9}},ExpressionUUID->"8b1f8b6a-7df3-496f-868c-\
25c75b232aca"],

Cell["\<\

So the PDF for a random step of length s is :\
\>", "Text",
 CellChangeTimes->{{3.827164569099614*^9, 
  3.827164597790604*^9}},ExpressionUUID->"06f42017-1d5f-476e-a255-\
6db2b1685874"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   StyleBox[
    RowBox[{
     SubscriptBox["p", "a"], 
     RowBox[{"(", "s", ")"}]}],
    FontColor->RGBColor[0.6, 0.4, 0.2]], 
   StyleBox["=",
    FontColor->RGBColor[0.6, 0.4, 0.2]], 
   RowBox[{
    StyleBox[
     RowBox[{"\[VerticalSeparator]", 
      FractionBox[
       SubscriptBox["d\[CapitalTau]", "a"], "ds"], "\[VerticalSeparator]", 
      RowBox[{"(", "s", ")"}]}],
     FontColor->RGBColor[0.6, 0.4, 0.2]], 
    StyleBox["=",
     FontColor->RGBColor[0.6, 0.4, 0.2]], 
    RowBox[{
     StyleBox[
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         SubscriptBox["d\[CapitalTau]", "a"], "ds"]}], 
       RowBox[{"(", "s", ")"}]}],
      FontColor->RGBColor[0.6, 0.4, 0.2]], 
     StyleBox["=",
      FontColor->RGBColor[0.6, 0.4, 0.2]], 
     StyleBox[
      FractionBox[
       OverscriptBox["\[Sigma]", "-"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{
           OverscriptBox["\[Sigma]", "-"], 
           RowBox[{"s", "/", "a"}]}]}], ")"}], 
        RowBox[{"a", "+", "1"}]]],
      FontColor->RGBColor[1, 0.5, 0]]}]}]}],
  FontSize->18]], "DisplayFormula",
 CellChangeTimes->{{3.8271646046920652`*^9, 
  3.827164689563239*^9}},ExpressionUUID->"8b3e3efa-0249-4c0b-b00a-\
9f9b903bc838"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"With", " ", "CDF", " ", "and", " ", "PDF"}], ",", 
     RowBox[{
      RowBox[{"let", "'"}], "s", " ", "find", " ", "sampling", " ", "fnc", 
      " ", "for", " ", "s"}]}], "*)"}], 
   RowBox[{
    RowBox[{"neTransmittance", "[", 
     RowBox[{"o_", ",", "s_", ",", "a_"}], "]"}], ":=", 
    RowBox[{"1", "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"o", "*", 
         RowBox[{"s", "/", "a"}]}]}], ")"}], "^", "a"}]}]}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"neTransmittance", "[", 
   RowBox[{"\[Sigma]_", ",", "s_", ",", "a_"}], "]"}], ":=", 
  RowBox[{"1", "/", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"\[Sigma]", "*", 
       RowBox[{"s", "/", "a"}]}]}], ")"}], "^", 
    "a"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nePdf", "[", 
    RowBox[{"\[Sigma]_", ",", "s_", ",", "a_"}], "]"}], ":=", 
   RowBox[{"\[Sigma]", "/", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"\[Sigma]", "*", 
        RowBox[{"s", "/", "a"}]}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"a", "+", "1"}], ")"}]}]}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"\[Sigma]", "*", 
           RowBox[{"s", "/", "a"}]}]}], ")"}], "^", "a"}]}], "\[Equal]", 
      "\[Xi]"}], ",", "s"}], "]"}], "]"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"neSample", "[", 
    RowBox[{"\[Sigma]_", ",", "a_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", "^", 
          RowBox[{"(", 
           RowBox[{"1", "/", "a"}], ")"}]}], "-", "1"}], ")"}], "/", 
       "\[Sigma]"}]}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"RandomReal", "[", "]"}], "}"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"our", " ", "sampling", " ", "routine"}], 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
