Cell[CellGroupData[{

Cell["Confirming the Densities Match Too", "Subchapter",ExpressionUUID->"2b95e1f1-9a5b-45ed-9db7-cf2e10a76d8d"],

Cell["\<\
A survival-function identity should imply the corresponding densities are \
identical too, since p(t) = -dT/dt. Build both as genuine \
ProbabilityDistribution objects, and compare the derived densities directly.\
\>", "Text",
 CellChangeTimes->{
  3.999240039807108*^9},ExpressionUUID->"b3d29d87-3163-4eeb-bdae-\
7a5026e84822"],

