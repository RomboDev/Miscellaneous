Cell["\<\
At the specific value \[Alpha]=1, this is what we compare against the \
hyperbolic law above.\
\>", "Text",ExpressionUUID->"fcca733b-2095-4759-8530-cebec851ea8e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Symbolic Identity Check", "Subchapter",ExpressionUUID->"29d466c6-9532-42a2-bdf9-ce708574976f"],

Cell["Define both transmittance functions exactly as stated above.", "Text",ExpressionUUID->"9192ba21-9189-47df-a26c-74a9bf7f1fd4"],

Cell["Clear[x, x0, t, sigma, beta, alpha, Thyp, TGL]", "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"990ca0d3-4752-48ca-bb53-8ef5b03d73aa"],

Cell["Thyp[x_, x0_] := x0/(x + x0)", "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"624fe1b3-e8ab-425b-9855-bd9a3ddf0674"],

Cell["\<\
TGL[t_, sigma_, alpha_, beta_] := (1 + sigma*t/beta)^(-alpha)\
\>", "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"0c9de78c-095e-44d8-999e-f6f3e12cce1e"],

Cell[TextData[{
 "The claim: ",
 StyleBox["TGL",
  FontSlant->"Italic"],
 " at \[Alpha]=1, with \[Beta]=\[Sigma]\[Times]x0, is identical to ",
 StyleBox["Thyp",
  FontSlant->"Italic"],
 ". Substitute and simplify:"
}], "Text",ExpressionUUID->"88353d83-da34-4391-90ea-16113e96a022"],

Cell[CellGroupData[{

Cell["TGLAlpha1 = TGL[t, sigma, 1, sigma*x0] // Simplify", "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"957bd326-8e95-4905-b7f4-315e6c48c06e"],

Cell[BoxData[
 FractionBox["x0", 
