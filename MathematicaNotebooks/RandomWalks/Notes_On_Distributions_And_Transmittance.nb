Cell[CellGroupData[{

Cell["Jarabo's Alternative Sampler", "Subchapter",
 CellChangeTimes->{{3.9994110827084455`*^9, 
  3.999411083148573*^9}},ExpressionUUID->"1135adb0-839a-4cdc-ba6b-\
c715ecaa4db8"],

Cell[TextData[{
 StyleBox["[see -> Jarabo, Aliaga & Gutierrez 2018, Equations 23-24]\n",
  FontSize->12,
  FontColor->GrayLevel[0.5]],
 "Davis & Xu's sampler above draws from the true free-flight density p(s), \
valid for any a>0. Jarabo et al. present a genuinely different alternative: \
sampling proportional to the transmittance T(s) itself, restricted to a>1, \
motivated by a specific variance concern for transmittance-style estimators \
(shadow rays, next-event estimation). In classical exponential media \
p(s)/T(s) is a constant; here it is the non-constant hazard rate \
\[CapitalSigma](s), and sampling proportional to T(s) directly restores a \
constant-ratio property Jensen\[CloseCurlyQuote]s inequality otherwise breaks."
}], "Text",
 CellChangeTimes->{{3.999500875031331*^9, 
  3.999500876151476*^9}},ExpressionUUID->"022955f4-66a5-4aca-b086-\
57d483fbf900"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Compare", " ", 
    RowBox[{"Davis", " ", "/", " ", "Jarabo"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nRndSamples", "=", "64"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freq", "=", "256"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"jaraboSample", "[", 
     RowBox[{"sig_", ",", "a_", ",", "xiv_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "/", "sig"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "xiv"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"1", "-", "a"}], ")"}]}], ")"}]}], "-", "1"}], ")"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"jaraboPDF", "[", 
     RowBox[{"sig_", ",", "a_", ",", "s_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", "^", 
        RowBox[{"(", 
         RowBox[{"a", "-", "1"}], ")"}]}], "*", "sig", "*", 
       RowBox[{"(", 
        RowBox[{"a", "-", "1"}], ")"}]}], ")"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "+", 
        RowBox[{"s", "*", "sig"}]}], ")"}], "^", "a"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{"sig", "*", 
               RowBox[{"s", "/", "a"}]}]}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"1", "-", "a"}], ")"}]}]}], ")"}]}], ",", "s"}], "]"}], 
      "-", 
      RowBox[{"jaraboPDF", "[", 
       RowBox[{"sig", ",", "a", ",", "s"}], "]"}]}], "]"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"sig", "*", 
            RowBox[{"s", "/", "a"}]}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"1", "-", "a"}], ")"}]}]}], ",", "s"}], "]"}], "-", 
     RowBox[{"jaraboPDF", "[", 
      RowBox[{"sig", ",", "a", ",", "s"}], "]"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fJarabo", "[", 
     RowBox[{"i_", ",", "sig_", ",", "a_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", ",", "d", ",", "datas"}], "}"}], ",", 
      RowBox[{
       RowBox[{"datas", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"jaraboSample", "[", 
            RowBox[{"sig", ",", "a", ",", 
             RowBox[{"RandomReal", "[", "]"}]}], "]"}], "/", "i"}], ",", 
          RowBox[{"{", "nRndSamples", "}"}]}], "]"}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"Mean", "[", "datas", "]"}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"s", "/", 
         RowBox[{"jaraboPDF", "[", 
          RowBox[{"sig", ",", "a", ",", "s"}], "]"}]}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"s", "*", "20"}]}], ";", 
       RowBox[{"d", "=", 
        RowBox[{"neTransmittance", "[", 
         RowBox[{"sig", ",", "s", ",", "a"}], "]"}]}], ";", "d"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fDavisXu", "[", 
     RowBox[{"i_", ",", "sig_", ",", "a_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", ",", "d", ",", "datas"}], "}"}], ",", 
      RowBox[{
       RowBox[{"datas", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"neSample", "[", 
            RowBox[{"sig", ",", "a", ",", 
             RowBox[{"RandomReal", "[", "]"}]}], "]"}], "/", "i"}], ",", 
          RowBox[{"{", "nRndSamples", "}"}]}], "]"}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"Mean", "[", "datas", "]"}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"s", "/", 
         RowBox[{"nePdf", "[", 
          RowBox[{"sig", ",", "s", ",", "a"}], "]"}]}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"s", "*", "20"}]}], ";", 
