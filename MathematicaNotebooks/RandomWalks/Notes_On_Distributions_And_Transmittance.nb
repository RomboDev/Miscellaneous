Cell[CellGroupData[{

Cell["Jarabo's Alternative Sampler", "Subchapter",
 CellChangeTimes->{{3.9994110827084455`*^9, 
  3.999411083148573*^9}},ExpressionUUID->"1135adb0-839a-4cdc-ba6b-\
c715ecaa4db8"],

Cell[TextData[{
 StyleBox["[see -> Jarabo, Aliaga & Gutierrez 2018, Equations 23-24]\n",
  FontSize->12,
  FontColor->GrayLevel[0.5]],
 "Davis & Xu's sampler above draws from the true free-flight density p(s), \
valid for any a>0 -- the one this whole dispatch architecture uses. Jarabo et \
al. present a genuinely different alternative: sampling proportional to the \
transmittance T(s) itself, restricted to a>1, motivated by a specific \
variance concern for transmittance-style estimators (shadow rays, next-event \
estimation). In classical exponential media p(s)/T(s) is a constant; here it \
is the non-constant hazard rate \[CapitalSigma](s), and sampling proportional \
to T(s) directly restores a constant-ratio property Jensen\[CloseCurlyQuote]s \
inequality otherwise breaks."
}], "Text",ExpressionUUID->"022955f4-66a5-4aca-b086-57d483fbf900"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Compare", " ", 
    RowBox[{"Davis", " ", "/", " ", "Jarabo"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"jaraboSample", "[", 
     RowBox[{"sig_", ",", "a_", ",", "xiv_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", "/", "sig"}], ")"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "xiv"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{"1", "-", "a"}], ")"}]}], ")"}]}], "-", "1"}], ")"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"jaraboPDF", "[", 
     RowBox[{"sig_", ",", "a_", ",", "s_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", "^", 
        RowBox[{"(", 
         RowBox[{"a", "-", "1"}], ")"}]}], "*", "sig", "*", 
       RowBox[{"(", 
        RowBox[{"a", "-", "1"}], ")"}]}], ")"}], "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "+", 
        RowBox[{"s", "*", "sig"}]}], ")"}], "^", "a"}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"sig", "*", 
              RowBox[{"s", "/", "a"}]}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"1", "-", "a"}], ")"}]}]}], ")"}]}], ",", "s"}], "]"}], 
     "-", 
     RowBox[{"jaraboPDF", "[", 
      RowBox[{"sig", ",", "a", ",", "s"}], "]"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fJarabo", "[", 
     RowBox[{"i_", ",", "sig_", ",", "a_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", ",", "d", ",", "datas"}], "}"}], ",", 
      RowBox[{
       RowBox[{"datas", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"jaraboSample", "[", 
            RowBox[{"sig", ",", "a", ",", 
             RowBox[{"RandomReal", "[", "]"}]}], "]"}], "/", "i"}], ",", 
          RowBox[{"{", "nRndSamples", "}"}]}], "]"}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"Mean", "[", "datas", "]"}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"s", "/", 
         RowBox[{"jaraboPDF", "[", 
          RowBox[{"sig", ",", "a", ",", "s"}], "]"}]}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"s", "*", "20"}]}], ";", 
       RowBox[{"d", "=", 
        RowBox[{"neTransmittance", "[", 
         RowBox[{"sig", ",", "s", ",", "a"}], "]"}]}], ";", "d"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"fDavisXu", "[", 
     RowBox[{"i_", ",", "sig_", ",", "a_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", ",", "d", ",", "datas"}], "}"}], ",", 
      RowBox[{
       RowBox[{"datas", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"neSample", "[", 
            RowBox[{"sig", ",", "a", ",", 
             RowBox[{"RandomReal", "[", "]"}]}], "]"}], "/", "i"}], ",", 
          RowBox[{"{", "nRndSamples", "}"}]}], "]"}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"Mean", "[", "datas", "]"}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"s", "/", 
         RowBox[{"nePdf", "[", 
          RowBox[{"sig", ",", "s", ",", "a"}], "]"}]}]}], ";", 
       RowBox[{"s", "=", 
        RowBox[{"s", "*", "20"}]}], ";", 
       RowBox[{"d", "=", 
        RowBox[{"neTransmittance", "[", 
         RowBox[{"sig", ",", "s", ",", "a"}], "]"}]}], ";", "d"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"MatrixPlot", "[", 
        RowBox[{
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"fDavisXu", "[", 
            RowBox[{"x", ",", "1.0", ",", "2.0"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "freq"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", "freq"}], "}"}]}], "]"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], ",", 
         RowBox[{"ColorFunctionScaling", "\[Rule]", "fncScaling"}], ",", 
         RowBox[{"Frame", "\[Rule]", "False"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "imageSize"}], ",", 
         RowBox[{
         "PlotLabel", "\[Rule]", 
          "\"\<Davis & Xu -- samples p(s) directly\>\""}]}], "]"}], ",", 
       RowBox[{"MatrixPlot", "[", 
        RowBox[{
         RowBox[{"ParallelTable", "[", 
          RowBox[{
           RowBox[{"fJarabo", "[", 
            RowBox[{"x", ",", "1.0", ",", "2.0"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "freq"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", "freq"}], "}"}]}], "]"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], ",", 
         RowBox[{"ColorFunctionScaling", "\[Rule]", "fncScaling"}], ",", 
         RowBox[{"Frame", "\[Rule]", "False"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "imageSize"}], ",", 
         RowBox[{
         "PlotLabel", "\[Rule]", 
          "\"\<Jarabo -- samples proportional to T(s), a>1 only\>\""}]}], 
        "]"}]}], "}"}], "}"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9994103448906937`*^9, 3.999410469613285*^9}, 
   3.999410576349233*^9, {3.999410733508442*^9, 3.999410739764702*^9}, {
   3.99941090926974*^9, 3.999410920775097*^9}, {3.9994111655552464`*^9, 
   3.9994112094010315`*^9}, {3.999411265000347*^9, 3.9994112673848886`*^9}, {
   3.9994113286271276`*^9, 3.9994113377634363`*^9}, {3.9994116315326195`*^9, 
   3.9994116335170183`*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"fff925b4-7a72-4d49-8687-cc3802d7a77b"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "a"}], ")"}], " ", "sig", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["a", "a"]}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"a", "+", 
         RowBox[{"s", " ", "sig"}]}], ")"}], 
       RowBox[{"-", "a"}]]}], "-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{"s", " ", "sig"}], "a"]}], ")"}], 
      RowBox[{"-", "a"}]]}], ")"}]}], "a"]], "Output",
 CellChangeTimes->{3.9994104709399333`*^9, 3.9994107766695986`*^9, 
  3.999410812730176*^9, 3.999411117264017*^9, 3.9994112683914785`*^9, 
  3.999411339033242*^9, 3.9994115827746296`*^9, 3.999411620775757*^9, 
  3.9994116994095016`*^9},
 CellLabel->"Out[92]=",ExpressionUUID->"257b350b-1ed8-4ab5-8ebc-2b4690dd311f"],

