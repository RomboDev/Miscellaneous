       "d"}]}], 
     "                                                                        \
                                                                              \
        ", 
     RowBox[{"(*", 
      RowBox[{
      "get", " ", "back", " ", "with", " ", "our", " ", "transmittance", " ", 
       "at", " ", "the", " ", "point"}], "*)"}], "]"}]}], 
   "\[IndentingNewLine]", 
   "                                                                          \
                                                                              \
   ", "\n", "\[IndentingNewLine]", 
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", "=", "2"}], "}"}], ",", 
         "                                                                    \
                                                           ", 
         RowBox[{"(*", 
          RowBox[{"different", " ", "variabilities"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"expdata", "=", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"x", ",", "a"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "freq"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", "freq"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"MatrixPlot", "[", 
           RowBox[{"expdata", ",", 
            RowBox[{"PlotRange", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}]}], ",", 
            RowBox[{"ColorFunctionScaling", "\[Rule]", "fncScaling"}], ",", 
            RowBox[{"Frame", "\[Rule]", "False"}], ",", 
