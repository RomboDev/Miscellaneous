Cell[TextData[{
 "Note the heavy tail relative to the dotted classical reference -- the \
entire reason this curve family is interesting in the first place. Both the \
hyperbolic and Gamma-Lomax derivations land on a transmittance that stays \
well above classical at large ",
 StyleBox["x",
  FontSlant->"Italic"],
 ", the signature of positive spatial correlation."
}], "Text",
 CellChangeTimes->{{3.999356325738097*^9, 
  3.999356327890381*^9}},ExpressionUUID->"83da9045-4af8-4d24-963d-\
9ce59f648d71"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stochastic Visualization", "Subchapter",ExpressionUUID->"bc279b57-8c07-45f6-9917-45712b68db0d"],

Cell[TextData[{
 StyleBox["[see -> earlier stochastic-gradient technique, exponential case]\n",
  FontSize->12,
  FontColor->GrayLevel[0.5]],
 "Draw random samples through each function\[CloseCurlyQuote]s own \
inverse-CDF sampler, importance-weight by the PDF, and let the resulting \
image carry real Monte Carlo noise (closer to what an actual renderer would \
produce than a smooth analytic plot)."
}], "Text",
 CellChangeTimes->{{3.999356344686301*^9, 3.999356369754919*^9}, {
  3.99935642132631*^9, 
  3.9993564226621456`*^9}},ExpressionUUID->"a148cd6f-ac2c-491c-acdc-\
455791b08656"],

Cell["\<\
Each function needs its own sampler -- solve T(s)=rnd for s, treating rnd as \
the survival value directly, matching the convention already used for \
neSample above.\
\>", "Text",
 CellChangeTimes->{{3.9993564299834046`*^9, 
  3.9993564322162933`*^9}},ExpressionUUID->"2d14d77c-8bd3-486c-b614-\
f935aa9e02d6"],

Cell["hypFnc[x0_, s_] := x0/(s + x0)", "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"e0a40242-fc06-46ed-9052-dbae9c6e8353"],

Cell["hypPDF[x0_, s_] := x0/(s + x0)^2", "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"a25709f4-07ab-4b1b-a60f-d84a54cfdd88"],

Cell["hypSample[x0_, rnd_] := x0*(1/rnd - 1)", "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"07bb859b-c54b-418e-986e-c09458025019"],

Cell["\<\
(* Gamma-Lomax at alpha=1, beta=x0 -- matching the identity substitution \
beta=sigma*x0 with sigma=1, i.e. the same scale as hypFnc above, for a fair \
side-by-side comparison *)\
\>", "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"bcc2f5ba-9419-424a-806f-5251d45cae56"],

Cell["glFnc[x0_, s_] := TGL[s, 1, 1, x0]", "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"27084fa1-9aa2-43d2-8290-b2a720cca76a"],

Cell["glPDF[x0_, s_] := D[1 - TGL[u, 1, 1, x0], u] /. u -> s", "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"81a1075e-d4d5-4c77-85a4-8640a6d6d9e0"],

Cell["glSample[x0_, rnd_] := x0*(rnd^(-1) - 1)", "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"b4272f74-289b-4b8a-b28a-923b1f8ca72a"],

Cell[TextData[{
 StyleBox["Check first",
  FontWeight->"Bold"],
 " that glSample and hypSample are the same formula before trusting the \
gradient at all -- if they weren\[CloseCurlyQuote]t, this whole visualization \
would be comparing two different distributions by accident:"
}], "Text",ExpressionUUID->"08495659-4023-4e9a-a951-00fe3d745dbf"],

Cell[CellGroupData[{

Cell["Simplify[hypSample[x0, rnd] - glSample[x0, rnd]]", "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"92b7e515-7f84-4969-8780-e36f33e88943"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.999351123707905*^9, 3.9993512034060893`*^9, 
  3.999351240979396*^9, 3.9993556862335014`*^9, 3.999357094853803*^9, 
  3.9993578231125946`*^9, 3.999409491991246*^9, 3.9994098848334904`*^9, 
  3.999410771195848*^9, 3.9994116891752377`*^9, 3.9994122858393044`*^9, 
  3.999412368446417*^9, 3.9994131144833975`*^9, 3.999413241566828*^9, 
  3.9995011380887384`*^9},
 CellLabel->"Out[37]=",ExpressionUUID->"aed53bc6-5bab-4330-840a-e7c2aedd460f"]
}, Open  ]],

Cell["(* Expect: 0 *)", "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"68dc2c26-dc64-40df-9eec-c63944e97f4c"],

Cell["\<\
The stochastic-gradient function itself, structured exactly like the \
exponential case: draw nRndSamples candidate distances, average them, \
importance-weight by the local PDF, feed the result back through the \
transmittance function.\
\>", "Text",ExpressionUUID->"0f9586f9-da54-4984-bfe3-6f7e2b43faa6"],

Cell["\<\
ClearAll[\"Global`imageSize\", \"Global`nRndSamples\", \"Global`freq\", \
\"Global`x0val\", \"Global`fncScaling\"]\
\>", "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"2b432dce-a478-4e32-8dcd-323d3c69fc7d"],

Cell["imageSize = Medium;", "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"0831b596-c065-4677-b689-485a35d6ecbd"],

Cell["fncScaling = True;", "Input",
 CellLabel->"In[41]:=",ExpressionUUID->"9477cf7a-9a26-4ea1-aaa8-96c775e0d582"],

Cell["nRndSamples = 64;", "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"bede6f58-6b32-4f03-b961-edce66b230cd"],

Cell["freq = 256;", "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"74510a9f-5cb1-4e52-a28c-5a947ac8e2d3"],

Cell["x0val = 2.0;", "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"d0d8f5cd-5547-4a92-9206-474669b59a2c"],

Cell["\<\
fHyp[i_, x0_] := Module[{s, d, datas}, datas = Table[hypSample[x0, \
RandomReal[]/i], {nRndSamples}]; s = Mean[datas]; s = s/hypPDF[x0, s]; s = \
s*20; d = hypFnc[x0, s]; d]\
\>", "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"9abadd48-d019-48df-bab6-5664850cf1ef"],

Cell["\<\
fGL[i_, x0_] := Module[{s, d, datas}, datas = Table[glSample[x0, \
RandomReal[]/i], {nRndSamples}]; s = Mean[datas]; s = s/glPDF[x0, s]; s = \
s*20; d = glFnc[x0, s]; d]\
\>", "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"792b999f-23d6-4bdb-b1d8-978bc9e54e2c"],

Cell[TextData[{
 StyleBox["Default: independent randomness in each panel.",
  FontWeight->"Bold"],
 " This shows the two gradients matching in overall shape and brightness."
}], "Text",
 CellChangeTimes->{{3.999356481842181*^9, 
  3.999356482194965*^9}},ExpressionUUID->"c41ffd18-f543-4b1a-a92c-\
c03e18f748e3"],

Cell[CellGroupData[{

Cell["\<\
GraphicsGrid[{{ MatrixPlot[ParallelTable[fHyp[x, x0val], {x, freq}, {y, \
freq}], PlotRange -> {0, 1}, Frame -> False, ImageSize -> imageSize, \
PlotLabel -> \"Casasanta-Garra hyperbolic\"], MatrixPlot[ParallelTable[fGL[x, \
x0val], {x, freq}, {y, freq}], PlotRange -> {0, 1}, Frame -> False, ImageSize \
-> imageSize, PlotLabel -> \"Gamma-Lomax, alpha=1\"] }}]\
\>", "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"7477a245-12b0-4f2b-9162-e836908058c4"],

