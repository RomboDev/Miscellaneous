        "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", "=", "20"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"expdata", "=", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"x", ",", "a"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "freq"}], "}"}], ",", 
             RowBox[{"{", 
