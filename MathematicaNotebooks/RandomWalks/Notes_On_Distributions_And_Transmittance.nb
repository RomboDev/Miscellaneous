     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"\[Sigma]", "*", 
        RowBox[{"s", "/", "a"}]}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"a", "+", "1"}], ")"}]}]}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FullSimplify", "[", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"\[Sigma]", "*", 
           RowBox[{"s", "/", "a"}]}]}], ")"}], "^", "a"}]}], "\[Equal]", 
      "\[Xi]"}], ",", "s"}], "]"}], "]"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"neSample", "[", 
