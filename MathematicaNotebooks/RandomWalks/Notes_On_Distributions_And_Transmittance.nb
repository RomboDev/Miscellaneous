Cell[CellGroupData[{

Cell["Hyperbolic in x, Not Exponential", "Subchapter",
 CellChangeTimes->{
  3.999271564366378*^9},ExpressionUUID->"06a1e3e8-a111-4186-ae56-\
cbc6da14dbf7"],

Cell[TextData[{
 "At \[Alpha]=1, the ",
 StyleBox["mixing distribution",
  FontSlant->"Italic"],
 " over \[Sigma] is exponential -- but the resulting ",
 StyleBox["transmittance",
  FontSlant->"Italic"],
 " T(x) is hyperbolic in x(ie. not exponential). And \
Jensen\[CloseCurlyQuote]s inequality is exactly why they \
can\[CloseCurlyQuote]t be: averaging a convex function over any nondegenerate \
distribution always pushes the result away from classical. The standard, \
unambiguous way to see this is a logarithmic y-axis: exponential decay is, by \
definition, a perfectly straight line there. Anything curving away from a \
straight line on this plot is not exponential, regardless of how it was \
constructed."
}], "Text",
 CellChangeTimes->{{3.9992696365962863`*^9, 3.9992696393795977`*^9}, {
  3.999269786105733*^9, 3.999269803660324*^9}, {3.999356512104952*^9, 
  3.99935653806236*^9}},ExpressionUUID->"a72c4c30-247e-4886-a253-\
c9b6debb4fbb"],

Cell[CellGroupData[{

Cell["\<\
LogPlot[{
\tThyp[x, 1], Exp[-x]}, {x, 1, 100}, 
\tPlotStyle -> {{RGBColor[1, 0.5, 0], Thickness[0.01]}, {RGBColor[0.5, 0.5, \
0.5], Dashed, Thickness[0.006]}}, 
\tPlotLegends -> {\"Hyperbolic / Gamma-Lomax at alpha=1\", \"Classical \
exponential, same rate\"}, 
\tAxesLabel -> {\"x\", \"T(x), log scale\"}, 
\tPlotLabel -> \"Classical is a straight line here by definition -- the \
hyperbolic curve is not one\", ImageSize -> 640]\
\>", "Input",
 CellChangeTimes->{{3.999269421233428*^9, 3.999269442569389*^9}, {
  3.9993220528312817`*^9, 3.999322109428602*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"24e7c9a3-db6e-4729-8a57-b25c8ad6443d"],

