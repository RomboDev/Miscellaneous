Cell["\<\
(* Expect: 0, confirming alpha = 1/CV^2 exactly, not just approximately or \
asymptotically *)\
\>", "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"60a400e8-4f3b-41a9-829f-a6ea5be9f5fb"],

Cell[TextData[{
 "So \[Alpha]=1 is not merely \[OpenCurlyQuote]a special value that happens \
to work\[CloseCurlyQuote] -- it is the specific point where CV",
 Cell[BoxData[
  SuperscriptBox["", "2"]],ExpressionUUID->
  "a438f209-d4fd-4f80-a9ea-9ff37fce9c2a"],
 "=1, the exact coefficient of variation of a plain exponential distribution. \
Every distribution in this family with \[Alpha]\[NotEqual]1 has \[Sigma] more \
tightly or more loosely concentrated around its mean than exponential; \
\[Alpha]=1 is the unique crossing point where that concentration matches the \
classical case exactly, which is the deeper reason the identity below lands \
there rather than anywhere else."
}], "Text",ExpressionUUID->"577b76b1-bdb3-42e7-ad6b-ea84aca06609"],

Cell["\<\
Seeing this directly: the shape of the \[Sigma]-distribution itself, at \
several \[Alpha], all holding the same mean \[Sigma]bar fixed.\
\>", "Text",ExpressionUUID->"36e31b01-ec78-4a8d-ac99-7d97a180a7e9"],

Cell[CellGroupData[{

Cell["\<\
Plot[Evaluate[Join[
\tTable[
\tPDF[GammaDistribution[a, 1/a], sig], {a, {0.3, 1, 3, 10}}], {
\tPDF[ExponentialDistribution[1], sig]}]], {sig, 0, 4}, 
\tPlotStyle -> {{RGBColor[0.8, 0.2, 0.2], Thickness[0.008]}, 
\t{RGBColor[1, 0.5, 0], Thickness[0.016]}, {RGBColor[0.2, 0.4, 0.8], \
Thickness[0.008]}, 
\t{RGBColor[0.1, 0.1, 0.1], Thickness[0.008]}, {Black, Dashed, \
Thickness[0.005]}}, 
\tPlotLegends -> {\"alpha=0.3 (diverging near zero, heavy tail)\", \"alpha=1 \
(Gamma)\", 
\t\"alpha=3\", \"alpha=10 (narrow, near-deterministic)\", 
\t\"Exponential(rate=1), overlaid\"}, AxesLabel -> {\"sigma\", \"PDF\"}, 
\tPlotLabel -> \"Same mean throughout -- the dashed exponential should vanish \
completely behind alpha=1\", 
\tImageSize -> 640]\
\>", "Input",
