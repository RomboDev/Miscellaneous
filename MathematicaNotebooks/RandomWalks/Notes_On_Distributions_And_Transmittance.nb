Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Stochastically", ",", " ", 
    RowBox[{
     RowBox[{"mimic", " ", "non"}], "-", 
     RowBox[{
     "exponential", " ", "transmittance", " ", "for", " ", "different", " ", 
      "variabilities"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"imageSize", "=", "Large"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fncScaling", "=", "True"}], ";"}], 
   "                                                                          \
               ", 
   RowBox[{"(*", 
    RowBox[{
    "set", " ", "it", " ", "to", " ", "False", " ", "to", " ", "have", " ", 
     "the", " ", "gradient", " ", "properly", " ", "in", " ", "BW"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nRndSamples", "=", "64"}], ";"}], 
   "                                                                          \
                 ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"the", " ", "higher"}], ",", 
     RowBox[{
     "the", " ", "less", " ", "noise", " ", "in", " ", "the", " ", 
      "gradient"}], ",", 
     RowBox[{"the", " ", "higher", " ", "calc", " ", "time"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freq", "=", "128"}], ";"}], 
   "                                                                          \
                              ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"scanline", " ", "frequency"}], ",", 
     RowBox[{
      RowBox[{"ie", ".", "how"}], " ", "much", " ", "we", " ", "divide", " ", 
      "the", " ", "unit", " ", "square"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"neTransmittance", "[", 
     RowBox[{"\[Sigma]_", ",", "s_", ",", "a_"}], "]"}], ":=", 
    RowBox[{"1", "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"\[Sigma]", "*", 
         RowBox[{"s", "/", "a"}]}]}], ")"}], "^", "a"}]}]}], 
   "                   ", "\n", 
   RowBox[{
    RowBox[{"nePdf", "[", 
     RowBox[{"\[Sigma]_", ",", "s_", ",", "a_"}], "]"}], ":=", 
    RowBox[{"\[Sigma]", "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"\[Sigma]", "*", 
         RowBox[{"s", "/", "a"}]}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"a", "+", "1"}], ")"}]}]}]}], "\n", 
   RowBox[{
    RowBox[{"neSample", "[", 
     RowBox[{"\[Sigma]_", ",", "a_", ",", "rnd_"}], "]"}], ":=", 
    RowBox[{"a", "*", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"rnd", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "a"}], ")"}]}], "-", "1"}], ")"}], "/", 
      "\[Sigma]"}]}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"i_", ",", "a_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", ",", "d", ",", "datas", ",", "\[Sigma]"}], "}"}], ",", 
      RowBox[{
       RowBox[{"\[Sigma]", "=", "1"}], ";", 
       "                                                                    ", 
       RowBox[{"(*", 
        RowBox[{"fixed", " ", "sigma"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"datas", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"neSample", "[", 
            RowBox[{"\[Sigma]", ",", "a", ",", 
             RowBox[{"RandomReal", "[", "]"}]}], "]"}], "/", "i"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "nRndSamples"}], "}"}]}], "]"}]}], ";", 
       "              ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"draw", " ", 
          RowBox[{"n", "'"}], 
          RowBox[{"probable", "'"}], " ", "distances"}], ";", 
         RowBox[{"note", ":", 
          RowBox[{"sample", "/", "freq"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"s", "=", 
        RowBox[{"Mean", "[", "datas", "]"}]}], ";", 
       "                                                                      \
                                                     ", 
       RowBox[{"(*", 
        RowBox[{"get", " ", "their", " ", "average"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"s", "=", 
        RowBox[{"s", "/", 
         RowBox[{"nePdf", "[", 
          RowBox[{"\[Sigma]", ",", "s", ",", "a"}], "]"}]}]}], ";", 
       "                                                                      \
                                          ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"divide", " ", "it", " ", "by", " ", "the", " ", "PDF"}], 
         ",", 
         RowBox[{"aka", " ", "importance", " ", "sampling"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"s", "=", 
        RowBox[{"s", "*", "20"}]}], ";", 
       "                                                                      \
                                                                     ", 
       RowBox[{"(*", 
        RowBox[{"optional", ":", 
         RowBox[{
          RowBox[{"compress", "/", "enlarge"}], " ", "exp", " ", "over", " ", 
          "the", " ", "unit"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
        RowBox[{"neTransmittance", "[", 
