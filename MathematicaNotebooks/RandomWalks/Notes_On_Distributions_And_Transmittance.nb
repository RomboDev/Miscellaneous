   RowBox[{
    RowBox[{
     RowBox[{"a", "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", "^", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "/", "a"}], ")"}]}], "-", "1"}], ")"}], "/", 
       "\[Sigma]"}]}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{"RandomReal", "[", "]"}], "}"}]}]}], " ", 
