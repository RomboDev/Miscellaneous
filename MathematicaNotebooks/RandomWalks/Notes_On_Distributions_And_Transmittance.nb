        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"neSample", "[", 
            RowBox[{"\[Sigma]", ",", "a", ",", 
             RowBox[{"RandomReal", "[", "]"}]}], "]"}], "/", "i"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "nRndSamples"}], "}"}]}], "]"}]}], ";", 
       "              ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"draw", " ", 
          RowBox[{"n", "'"}], 
          RowBox[{"probable", "'"}], " ", "distances"}], ";", 
         RowBox[{"note", ":", 
          RowBox[{"sample", "/", "freq"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"s", "=", 
        RowBox[{"Mean", "[", "datas", "]"}]}], ";", 
       "                                                                      \
                                                     ", 
       RowBox[{"(*", 
        RowBox[{"get", " ", "their", " ", "average"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"s", "=", 
        RowBox[{"s", "/", 
         RowBox[{"nePdf", "[", 
          RowBox[{"\[Sigma]", ",", "s", ",", "a"}], "]"}]}]}], ";", 
       "                                                                      \
                                          ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"divide", " ", "it", " ", "by", " ", "the", " ", "PDF"}], 
         ",", 
         RowBox[{"aka", " ", "importance", " ", "sampling"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"s", "=", 
        RowBox[{"s", "*", "20"}]}], ";", 
       "                                                                      \
                                                                     ", 
       RowBox[{"(*", 
        RowBox[{"optional", ":", 
         RowBox[{
          RowBox[{"compress", "/", "enlarge"}], " ", "exp", " ", "over", " ", 
          "the", " ", "unit"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
        RowBox[{"neTransmittance", "[", 
         RowBox[{"\[Sigma]", ",", "s", ",", "a"}], "]"}]}], ";", 
       "                                                                      \
                          ", 
       RowBox[{"(*", 
        RowBox[{
        "feed", " ", "the", " ", "exp", " ", "fnc", " ", "with", " ", "the", 
         " ", "stochastic", " ", "distance"}], "*)"}], "\[IndentingNewLine]", 
       "d"}]}], 
     "                                                                        \
                                                                              \
        ", 
     RowBox[{"(*", 
      RowBox[{
      "get", " ", "back", " ", "with", " ", "our", " ", "transmittance", " ", 
       "at", " ", "the", " ", "point"}], "*)"}], "]"}]}], "\n", 
   "                                                                          \
                                                                              \
   ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", "=", "2"}], "}"}], ",", 
         "                                                                    \
                                                           ", 
         RowBox[{"(*", 
          RowBox[{"different", " ", "variabilities"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"expdata", "=", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"x", ",", "a"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", "freq"}], "}"}], ",", 
             RowBox[{"{", 
