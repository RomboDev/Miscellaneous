     RowBox[{"o_", ",", "s_", ",", "a_"}], "]"}], ":=", 
    RowBox[{"1", "/", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"o", "*", 
         RowBox[{"s", "/", "a"}]}]}], ")"}], "^", "a"}]}]}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"neTransmittance", "[", 
   RowBox[{"\[Sigma]_", ",", "s_", ",", "a_"}], "]"}], ":=", 
