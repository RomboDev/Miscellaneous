Cell[CellGroupData[{

Cell["A More Robust Comparison: Direct Averaging", "Subchapter",ExpressionUUID->"1155f25e-3f70-494d-8850-3b37c2476c47"],

Cell["Numerically more robust version.", "Text",
 CellChangeTimes->{{3.999413011546465*^9, 
  3.9994130256192465`*^9}},ExpressionUUID->"be3fe6b1-283f-49a8-a7af-\
a4ab6ba3d4e2"],

Cell[CellGroupData[{

Cell["\<\
(* Average the transmittance values directly across samples, rather than \
averaging distances then dividing by the density at that average. *)
(* The earlier recipe is well-behaved for Davis-Xu's density but unstable for \
Jarabo's *)
(* dividing by jaraboPDF at an averaged distance occasionally blows up by \
orders of magnitude, since jaraboPDF is sharply peaked near s=0. *)
(* Direct averaging never divides by any density at all, avoiding that \
instability entirely for both. *)

nRndSamples=64;
freq=256;

fDavisXuRobust[i_, sig_, a_] := Module[{vals},
  vals = Table[neTransmittance[sig, 10*neSample[sig, a, RandomReal[]]/i, a], \
{nRndSamples}];
  Mean[vals]]

fJaraboRobust[i_, sig_, a_] := Module[{vals},
  vals = Table[neTransmittance[sig, 10*jaraboSample[sig, a, RandomReal[]]/i, \
a], {nRndSamples}];
  Mean[vals]]

GraphicsGrid[{{MatrixPlot[
    ParallelTable[fDavisXuRobust[x, 1.0, 2.0], {x, freq}, {y, freq}],
    PlotRange -> {0, 1}, ColorFunctionScaling -> fncScaling,
    Frame -> False, ImageSize -> imageSize,
    PlotLabel -> \"Davis & Xu, direct averaging\"],
   MatrixPlot[
    ParallelTable[fJaraboRobust[x, 1.0, 2.0], {x, freq}, {y, freq}],
    PlotRange -> {0, 1}, ColorFunctionScaling -> fncScaling,
    Frame -> False, ImageSize -> imageSize,
    PlotLabel -> \"Jarabo, direct averaging\"]}}]
\
\>", "Input",
 CellChangeTimes->{{3.9994130335331964`*^9, 3.9994130976448307`*^9}, {
  3.9994131606043596`*^9, 3.9994131931514235`*^9}, {3.9994133611014185`*^9, 
  3.999413366820178*^9}, {3.999413396960952*^9, 3.9994133978985043`*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"af8377de-81f8-40af-8c85-0d3392eb22a1"],

