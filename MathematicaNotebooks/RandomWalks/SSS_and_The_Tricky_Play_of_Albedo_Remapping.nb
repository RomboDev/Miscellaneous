Cell["\<\
Where the color lives: \[Sigma]s and \[Sigma]a per channel. Per-channel \
remaps spread color over both; Adobe keeps \[Sigma]s gray, Framestore tints \
it along the Mie\[Dash]Rayleigh line. The swatch is the scattering color \
alone.\
\>", "Text",ExpressionUUID->"3a77d1fb-3ef5-49fa-9fd2-4323735469d2"],

Cell[CellGroupData[{

Cell["\<\
swatch[v_] := Graphics[{RGBColor @@ (v/Max[v]), Rectangle[]}, ImageSize -> 40];

Manipulate[
 Grid[Prepend[
   Table[With[{sa = sigmaSA[m, {ar, ag, ab}, 1., g, w, False]},
     {m,
      BarChart[sa, ChartLayout -> \"Grouped\", ChartStyle -> {Red, Green, \
Blue},
       ChartLabels -> {{\"\[Sigma]s\", \"\[Sigma]a\"}, None}, ImageSize -> \
260, AspectRatio -> 0.5],
      swatch[sa[[1]]]}], {m, remaps}],
   {\"\", \"radius 1, paper conventions\", \"\[Sigma]s color\"}], Alignment \
-> {Left, Center}],
 {{g, 0., \"g\"}, 0., 0.95, Appearance -> \"Labeled\"},
 {{w, 0.64, \"Framestore w\"}, 0., 1., Appearance -> \"Labeled\"},
 Delimiter,
 {{ar, 0.8, \"A red\"}, 0.01, 0.99}, {{ag, 0.4, \"A green\"}, 0.01, 0.99}, \
{{ab, 0.2, \"A blue\"}, 0.01, 0.99}]\
\>", "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"981d804c-790c-4168-a449-72489c35c4e3"],

