Cell[CellGroupData[{

Cell["\<\
(* Theory vs samples: free flights and bounces before absorption *)
bounceCount = Compile[{{alpha, _Real}, {n, _Integer}},   (* same survival \
rule as the walk *)
   Table[Module[{k = 1}, While[RandomReal[] <= alpha, k++]; k], {n}]];

With[{sigmaT = 2., alpha = 0.98, n = 10^5},
 GraphicsRow[{
   Show[
    Histogram[-Log[RandomReal[1, n]]/sigmaT, 100, \"PDF\", PlotTheme -> \
\"WarmColor\"],
    Plot[sigmaT Exp[-sigmaT s], {s, 0, 4}, PlotRange -> All,
     PlotStyle -> {Green, Opacity[0.75]}],
    PlotLabel -> \"free flight s ~ \[Sigma]t e^(-\[Sigma]t s)\"],
   Show[
    Histogram[bounceCount[alpha, n], {1, 300, 5}, \"PDF\",
     PlotTheme -> \"WarmColor\"],
    Plot[(1 - alpha) alpha^(k - 1), {k, 1, 300}, PlotRange -> All,
     PlotStyle -> {Green, Opacity[0.75]}],
    PlotLabel -> \"bounces before absorption, mean 1/(1 - \[Alpha]) = 50\"]},
  ImageSize -> 900]]\
\>", "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"d8adadd0-55ba-4333-a223-3613a86ccfef"],

