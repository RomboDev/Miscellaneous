Cell[CellGroupData[{

Cell["Checks", "Subsection",ExpressionUUID->"6c6a3ad5-eba7-407c-aa3f-afe0c665c173"],

Cell[CellGroupData[{

Cell["\<\
TableForm[{
  {\"blue vs red scattering, 460 vs 640 nm\", (640./460.)^4},
  {\"Adobe red | blue extinction scale\", adobeScale[[{1, 3}]]},
  {\"Adobe red | blue mean free path at rayleigh = 1\", 1/adobeScale[[{1, \
3}]]},
  {\"Framestore r mean\", Mean[framestoreR]},
  {\"implied lambda_red / lambda_blue   Adobe | Framestore\", {640./460., \
(framestoreR[[3]]/framestoreR[[1]])^(1/4)}}}]\
\>", "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"f976347c-6cec-4e39-92ea-b2b8997208fc"],

