Cell["\<\
(* the article's numbers: radius 1, g = 0, bright channel A = 0.8, dark \
channel A = 0.2 *)
probe = {0.8, 0.5, 0.2};
TableForm[
 Table[{m, sigmaT[m, probe, 1., 0., 0., True][[{1, 3}]]}, {m, Most[remaps]}],
 TableHeadings -> {None, {\"pipeline \[Sigma]t\", \"{bright, dark}\"}}]

(* Framestore skin example (paper conventions, w = 0.64, radius 1) *)
sigmaSA[\"Framestore\", {0.8, 0.4, 0.2}, 1., 0., 0.64, False]

(* Adobe: sigma_s identical in every channel, whatever the color *)
Equal @@ Round[First[sigmaSA[\"Adobe\", RandomReal[{0.05, 0.95}, 3], 1., 0.5, \
0., False]], 10.^-10]\
\>", "Input",
 CellLabel->"In[66]:=",ExpressionUUID->"6c89dc76-a768-4a99-83ef-843c76f878a0"],

