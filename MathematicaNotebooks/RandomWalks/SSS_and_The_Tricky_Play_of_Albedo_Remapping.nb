Cell[CellGroupData[{

Cell["2. The remaps", "Section",
 CellChangeTimes->{{4.0034057299125657`*^9, 
  4.00340573011965*^9}},ExpressionUUID->"3ffe856d-6e17-4fa2-9acf-\
97df945e7df7"],

Cell[CellGroupData[{

Cell["Phase function and g", "Subsection",ExpressionUUID->"9e5ae6ba-6a2a-4e97-bc17-32941f17076a"],

Cell[CellGroupData[{

Cell["\<\
(* Henyey-Greenstein: one parameter, g = mean cosine *)
pHG[g_, ct_] := (1 - g^2)/(4 Pi (1 + g^2 - 2 g ct)^(3/2));

LogPlot[Evaluate[Table[pHG[g, Cos[th]], {g, {0., 0.3, 0.6, 0.8, -0.3}}]], \
{th, 0, Pi},
 Frame -> True, ImageSize -> 500, PlotTheme -> \"WarmColor\",
 PlotLegends -> {\"g = 0\", \"g = 0.3\", \"g = 0.6\", \"g = 0.8\", \"g = -0.3\
\"},
 FrameLabel -> {\"\[Theta] (rad)\", \"p(\[Theta])\"}]

(* normalized, and its mean cosine is g *)
Table[{g, NIntegrate[2 Pi pHG[g, mu], {mu, -1, 1}, AccuracyGoal -> 10],
   NIntegrate[2 Pi mu pHG[g, mu], {mu, -1, 1}, AccuracyGoal -> 10]}, {g, {0., \
0.5, 0.8}}]   (* in mu = cos(theta); absolute accuracy, since the g = 0 mean \
is exactly 0 *) //
 TableForm[#, TableHeadings -> {None, {\"g\", \"\[Integral] p d\[Omega]\", \
\"mean cos\"}}] &\
\>", "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"f6a57b91-9e09-4e3b-8a35-c5557f1a378e"],

