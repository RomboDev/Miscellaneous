Cell["\<\
Same 1/\[Lambda]^4, two normalizations: Adobe pins green to 1, Framestore \
makes the three channels average to 1.\
\>", "Text",ExpressionUUID->"fbf0b420-36f7-4cd4-815f-4ef2d6e53d08"],

Cell[CellGroupData[{

Cell["\<\
adobeScale = rayleigh /@ lambdaRGB;                  (* {~0.51, 1, ~1.90} *)
framestoreR = {0.553, 0.808, 1.640};                 (* mean 1 *)

BarChart[{adobeScale, framestoreR}, ChartLayout -> \"Grouped\", ChartStyle -> \
{Red, Green, Blue},
 ChartLabels -> {{\"Adobe (green = 1)\", \"Framestore (mean = 1)\"}, None},
 GridLines -> {None, {1}}, Frame -> True, ImageSize -> 450]\
\>", "Input",
 CellLabel->
  "In[115]:=",ExpressionUUID->"0d27782c-6bd9-45d6-b13d-83dde2185740"],

