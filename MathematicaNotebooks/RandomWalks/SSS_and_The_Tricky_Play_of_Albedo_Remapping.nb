Cell[CellGroupData[{

Cell["3. The radius", "Section",
 CellChangeTimes->{{4.0034057354496484`*^9, 
  4.0034057372803187`*^9}},ExpressionUUID->"37f01d45-e70f-4598-ac56-\
58d713b70e3b"],

Cell["\<\
(* sigma_t per channel, per remap. col = {Ar, Ag, Ab}, r = radius, w = \
Framestore Rayleigh fraction.
   massaged = True: pipeline-style radius (r/4Pi, then /s(A) for all but \
Framestore). Adobe is never massaged. *)
burleyS[A_] := 1.9 - A + 3.5 (A - 0.8)^2;
rayleighR = {0.553, 0.808, 1.640};
remaps = {\"Disney\", \"Imageworks\", \"Pixar\", \"Framestore\", \"Adobe\"};

alphaOf[m_, A_, g_] := Switch[m,
   \"Disney\" | \"Framestore\", alphaChiang[A],
   \"Imageworks\" | \"Adobe\", alphaVdH[A, g],
   \"Pixar\", alphaPixar[A, g]];

sigmaT[m_, col_List, r_, g_, w_, massaged_] := Module[{al, d},
   al = alphaOf[m, #, g] & /@ col;
   d = Which[
     m === \"Adobe\" || ! massaged, ConstantArray[r, 3],
     m === \"Framestore\", ConstantArray[r/(4 Pi), 3],
     True, r/(4 Pi)/(burleyS /@ col)];
   Switch[m,
    \"Disney\", 1/(d (burleyS /@ col)),
    \"Imageworks\", 1/d,
    \"Pixar\", 1/(d (1 - g)),
    \"Framestore\", (rayleighR w + (1 - w))/(al d),
    \"Adobe\", With[{amax = Max[al]}, (1/r) amax/Max[#, amax 10^-3] & /@ al]]];

sigmaSA[m_, col_, r_, g_, w_, massaged_] := With[{st = sigmaT[m, col, r, g, \
w, massaged], al = alphaOf[m, #, g] & /@ col},
   {al st, st - al st}];   (* {sigma_s, sigma_a} *)\
\>", "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"53393122-e139-466d-848f-3c22842d7e51"],

Cell["\<\
Same color, same radius: \[Sigma]t per channel for every remap. Tick the \
pipeline box to see what the 4\[Pi] and s(A) massaging does.\
\>", "Text",ExpressionUUID->"c798e0a5-a369-456e-a33b-b406a9b60302"],

Cell[CellGroupData[{

Cell["\<\
Manipulate[
 BarChart[Table[sigmaT[m, {ar, ag, ab}, r, g, w, massaged], {m, remaps}],
  ChartLayout -> \"Grouped\", ChartStyle -> {Red, Green, Blue},
  ChartLabels -> {remaps, None}, ScalingFunctions -> \"Log\",
  Frame -> True, FrameLabel -> {None, \"\[Sigma]t\"}, ImageSize -> 600],
 {{massaged, True, \"pipeline (4\[Pi], s(A))\"}, {True, False}},
 {{r, 1., \"radius\"}, 0.1, 5., Appearance -> \"Labeled\"},
 {{g, 0., \"g\"}, 0., 0.95, Appearance -> \"Labeled\"},
 {{w, 0., \"Framestore w\"}, 0., 1., Appearance -> \"Labeled\"},
 Delimiter,
 {{ar, 0.8, \"A red\"}, 0.01, 0.99}, {{ag, 0.4, \"A green\"}, 0.01, 0.99}, \
{{ab, 0.2, \"A blue\"}, 0.01, 0.99}]\
\>", "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"534249fc-d6c2-4f74-a52c-8c851e4d8190"],

