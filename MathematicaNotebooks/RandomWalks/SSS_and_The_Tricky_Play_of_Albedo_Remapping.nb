Cell[CellGroupData[{

Cell["4. Chromatic extinction: sampling distances", "Section",
 CellChangeTimes->{{4.003405743306175*^9, 
  4.0034057446420703`*^9}},ExpressionUUID->"2e496f47-d8c0-4075-b185-\
2d76a106db40"],

Cell["\<\
Three channels, three \[Sigma]t. Estimate the light scattered inside a slab \
of thickness d, the integral over [0, d] of \[Sigma]s e^(\[Minus]\[Sigma]t t) \
dt, per channel, from one sampled distance. A: sample with red's \[Sigma]t. \
B: pick the channel by albedo (\[Times] throughput, here 1), then weight by \
all three channels' pdfs (one-sample MIS, balance heuristic).\
\>", "Text",ExpressionUUID->"097263c9-61a8-4adc-8101-96b2e330a146"],

Cell["\<\
(* Setup: sigma_t red = 1, blue = k, green in between; distances on [0, d] *)
albedo3 = {0.9, 0.8, 0.7};
sigmaTOf[k_] := {1., Sqrt[k], k};

sampleT[s_, d_] := -Log[1 - RandomReal[] (1 - Exp[-s d])]/s;            (* \
truncated exponential *)
pdfT[s_, d_, t_] := s Exp[-s t]/(1 - Exp[-s d]);                           (* \
listable over channels *)

fCh[st_, t_] := albedo3 st Exp[-st t];                                     (* \
sigma_s e^(-sigma_t t) *)
exactCh[st_, d_] := albedo3 (1 - Exp[-st d]);

estRed[st_, d_] := With[{t = sampleT[st[[1]], d]}, fCh[st, t]/pdfT[st[[1]], \
d, t]];

estMIS[st_, d_] := Module[{q = albedo3/Total[albedo3], j, t},
   j = RandomChoice[q -> {1, 2, 3}];
   t = sampleT[st[[j]], d];
   fCh[st, t]/Total[q pdfT[st, d, t]]];\
\>", "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"b2ef32ba-82c6-4d16-8711-b85132b4b571"],

Cell[CellGroupData[{

Cell["\<\
(* Monte Carlo Estimator Variance Benchmark *)
(* TOP: relative variance of the blue channel (log10, 64 trials per pixel) | \
BOTTOM: single-sample (N=1) blue estimate / exact *)
(* x: blue/red extinction ratio k in [1, 20], y: slab thickness d in [0.1, 5] \
mean free paths of red *)
(* first run launches the parallel kernels; SeedRandom does not reach them, \
so maps vary slightly run to run *)

nTrials = 64; res = 32; freq = 128;
kOf[i_, n_] := 1. + 19. (i - 1)/(n - 1);
dOf[i_, n_] := 0.1 + 4.9 (i - 1)/(n - 1);

relVar[est_, k_, d_] := With[{st = sigmaTOf[k]},
   Log10[Max[10^-6, Variance[Table[est[st, d][[3]], {nTrials}]]/exactCh[st, \
d][[3]]^2]]];   (* k = 1: all channels equal, zero variance *)

redVar = ParallelTable[relVar[estRed, kOf[x, res], dOf[y, res]], {y, res}, \
{x, res}];
misVar = ParallelTable[relVar[estMIS, kOf[x, res], dOf[y, res]], {y, res}, \
{x, res}];
range = MinMax[Flatten[{redVar, misVar}]];

redNoise = ParallelTable[With[{st = sigmaTOf[kOf[x, freq]], d = dOf[y, freq]},
    estRed[st, d][[3]]/exactCh[st, d][[3]]], {y, freq}, {x, freq}];
misNoise = ParallelTable[With[{st = sigmaTOf[kOf[x, freq]], d = dOf[y, freq]},
    estMIS[st, d][[3]]/exactCh[st, d][[3]]], {y, freq}, {x, freq}];

GraphicsGrid[{{
   MatrixPlot[redVar, ColorFunction -> \"SunsetColors\", PlotRange -> range, \
DataReversed -> True,
    PlotLabel -> \"A: red's \[Sigma]t, log10 rel. variance\"],
   MatrixPlot[misVar, ColorFunction -> \"SunsetColors\", PlotRange -> range, \
DataReversed -> True,
    PlotLabel -> \"B: albedo-weighted MIS, log10 rel. variance\"]}}, \
ImageSize -> 800]
GraphicsGrid[{{
   MatrixPlot[redNoise, PlotRange -> {0, 2}, ColorFunction -> \"GrayTones\", \
DataReversed -> True,
    PlotLabel -> \"A: N=1 blue / exact\"],
   MatrixPlot[misNoise, PlotRange -> {0, 2}, ColorFunction -> \"GrayTones\", \
DataReversed -> True,
    PlotLabel -> \"B: N=1 blue / exact\"]}}, ImageSize -> 800]\
\>", "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"7aaa5cd8-61f5-4fcc-950e-30cf47671616"],

