Notebook[{

Cell[CellGroupData[{
Cell["SSS and the Tricky Play of Albedo Remapping", "Title",ExpressionUUID->"647dbf1b-3544-48e6-89e9-3284b1645ee5"],

Cell["Companion notebook", "Subtitle",ExpressionUUID->"25ecb932-5ccc-403e-9820-d266c932ed5f"],

Cell[TextData[StyleBox["Max Tarpini \[CenterDot] rombo.tools",
 FontSlant->"Italic"]], "Author",ExpressionUUID->"2fd76875-4989-4227-a3a7-\
76454d6d3696"],

Cell["\<\
The article tells the story, this notebook lets you play with it: simulate \
the curve, drag the remaps, watch the radius and the noise. 
Read the article first: [link to the article].
Evaluation -> Evaluate Notebook. Sections 2 and 5 may take a few seconds.\
\>", "Text",
 CellChangeTimes->{{4.002373278111946*^9, 4.002373297249144*^9}, {
  4.0034057130573516`*^9, 
  4.003405723007607*^9}},ExpressionUUID->"88f24ad1-6ceb-45f2-ba17-\
46158e669514"],

Cell[CellGroupData[{

Cell["1. Making the curve", "Section",
 CellChangeTimes->{
  4.00340569011911*^9, {4.003405788669732*^9, 
   4.00340579022995*^9}},ExpressionUUID->"262440df-58b8-45a6-8d4d-\
4b88a2a4dc0a"],

Cell["\<\
A tiny Monte Carlo: shoot light into a semi-infinite slab (isotropic \
scattering, index-matched boundary, diffuse incidence, distances in mean free \
paths) and count what comes back. That is A for a given \[Alpha]. Then fit \
Disney's curve shape on our own data.\
\>", "Text",ExpressionUUID->"783d9691-72cb-4ce9-bdf8-abe8099e8d76"],

Cell["\<\
SeedRandom[2026];

slabAlbedo = Compile[{{alpha, _Real}, {n, _Integer}},
   Module[{esc = 0, z = 0., mu = 1., alive = True},
    Do[
     z = 0.; mu = Sqrt[RandomReal[]]; alive = True;   (* diffuse \
(cosine-weighted) entry *)
     While[alive,
      z += -mu Log[RandomReal[]];                  (* free flight, sigma_t = \
1 *)
      If[z < 0.,
       esc++; alive = False,                        (* back out through the \
surface *)
       If[RandomReal[] > alpha,
        alive = False,                              (* absorbed *)
        mu = 2. RandomReal[] - 1.]                  (* isotropic bounce *)
       ]],
     {n}];
    1. esc/n]];\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"b1ad54aa-ad31-48a6-bc9a-426375f44d1e"],

Cell[CellGroupData[{

Cell["\<\
alphas = Join[Range[0.05, 0.95, 0.05], {0.97, 0.98, 0.99, 0.995, 0.998}];

AbsoluteTiming[
 data = Table[{slabAlbedo[a, 20000], a}, {a, alphas}];   (* pairs {A, alpha} *)
]\
\>", "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"14d3b960-08c9-492a-b6d1-fd568d437b17"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.5668924`", ",", "Null"}], "}"}]], "Output",
 CellChangeTimes->{4.0023732716019564`*^9, 4.003329941792739*^9, 
  4.0034057692751827`*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"c454a4af-3f7d-49ce-83e4-d5ee3ecd62dd"]
}, Open  ]],

Cell["\<\
Fit Disney's shape, \[Alpha] = 1 \[Minus] exp(c1 A + c2 A\.b2 + c3 A\.b3), on \
the simulated points:\
\>", "Text",ExpressionUUID->"17d633b5-30b8-49cf-bce4-8fee4be1af18"],

Cell[CellGroupData[{

Cell["\<\
fit = FindFit[data, 1 - Exp[c1 A + c2 A^2 + c3 A^3], {{c1, -5}, {c2, 2}, {c3, \
-4}}, A];

Grid[{
  {\"\", \"c1\", \"c2\", \"c3\"},
  {\"our fit\", c1 /. fit, c2 /. fit, c3 /. fit},
  {\"Disney (Chiang et al. 2016)\", -5.09406, 2.61188, -4.31805}},
 Frame -> All, Alignment -> Right]\
\>", "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"a2581fee-4266-48ed-accd-11a0d6b9515c"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"\"\>", "\<\"c1\"\>", "\<\"c2\"\>", "\<\"c3\"\>"},
    {"\<\"our fit\"\>", 
     RowBox[{"-", "4.908034877818614`"}], "1.7618812343616275`", 
     RowBox[{"-", "3.354265954275783`"}]},
    {"\<\"Disney (Chiang et al. 2016)\"\>", 
     RowBox[{"-", "5.09406`"}], "2.61188`", 
     RowBox[{"-", "4.31805`"}]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Right}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{4.0023732716373243`*^9, 4.003329941835275*^9, 
  4.003405769314809*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"89abc1d3-32a1-49cd-a805-9e770bedba44"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
alphaChiang[A_] := 1 - Exp[-5.09406 A + 2.61188 A^2 - 4.31805 A^3];

alphaVdH[A_, g_: 0] := Module[{s = 4.09712 + 4.20863 A - Sqrt[9.59217 + \
41.6808 A + 17.7126 A^2]},
   (1 - s^2)/(1 - g s^2)];

Show[
 Plot[{alphaChiang[A], alphaVdH[A], 1 - Exp[c1 A + c2 A^2 + c3 A^3] /. fit, \
A}, {A, 0, 1},
  PlotStyle -> {Thick, Dashed, Directive[Thick, Orange], Directive[Gray, \
Dotted]},
  PlotLegends -> {\"Disney (Chiang et al. 2016)\", \"Imageworks / van de \
Hulst (g = 0)\", \"our fit\", \"\[Alpha] = A\"}],
 ListPlot[data, PlotStyle -> Directive[Black, PointSize[Medium]], PlotLegends \
-> {\"Monte Carlo\"}],
 Frame -> True, PlotRange -> {{0, 1}, {0, 1}}, AspectRatio -> 1, ImageSize -> \
550,
 FrameLabel -> {\"A  (multiple-scattering albedo)\", \"\[Alpha]  \
(single-scattering albedo)\"}]\
\>", "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"6c115c26-7994-4bbb-96cf-f8e5790eb90f"],

