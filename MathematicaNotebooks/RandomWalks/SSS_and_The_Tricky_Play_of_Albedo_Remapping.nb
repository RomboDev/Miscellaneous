Cell[CellGroupData[{

Cell["Checks", "Subsection",ExpressionUUID->"c011c599-578c-41f1-8026-7b76e2afa2e0"],

Cell[CellGroupData[{

Cell["\<\
clampFrom[g_] := First[Select[Range[0., 1., 0.001], alphaPixarRaw[#, g] >= \
0.999999 &], None];

TableForm[{
  {\"max |Imageworks - Disney| at g = 0\", Max[Table[Abs[alphaVdH[A] - \
alphaChiang[A]], {A, 0, 1, 0.001}]]},
  {\"A = 0.5, g = 0    Pixar | Imageworks\", {alphaPixar[0.5, 0.], \
alphaVdH[0.5, 0.]}},
  {\"A = 0.5, g = 0.8  Pixar | Imageworks\", {alphaPixar[0.5, 0.8], \
alphaVdH[0.5, 0.8]}},
  {\"A = 0.5, g = -0.3 Pixar raw fit\", alphaPixarRaw[0.5, -0.3]},
  {\"Pixar hits the clamp from A =  (g = 0 | 0.5 | 0.8)\", clampFrom /@ {0., \
0.5, 0.8}},
  {\"Disney at A = 0.5, g = 0.8 renders A =\", AvdH[alphaChiang[0.5], 0.8]}}]\
\>", "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"c399a13d-7d72-4b5a-ae15-ddf1b8f5ac53"],

