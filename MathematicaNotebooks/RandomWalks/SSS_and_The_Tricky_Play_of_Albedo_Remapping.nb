Cell["\<\
The Monte Carlo points land on top of both published curves. The fitted \
constants still differ a bit from Chiang's: an exp-cubic is forgiving, and \
quite different constant sets draw nearly the same curve.\
\>", "Text",ExpressionUUID->"4140e379-66b8-4620-8339-0cca99c935cb"],

Cell[CellGroupData[{

Cell["Checks", "Subsection",ExpressionUUID->"3f0bc3fb-c800-4f74-966b-e0b40c11b614"],

Cell[CellGroupData[{

Cell["\<\
(* Monte Carlo vs van de Hulst's forward formula (g = 0) *)
AvdH[a_, g_: 0] := Module[{s = Sqrt[(1 - a)/(1 - g a)]}, (1 - 0.139 s) (1 - \
s)/(1 + 1.17 s)];

TableForm[
 Table[{d[[2]], d[[1]], AvdH[d[[2]]], d[[1]] - AvdH[d[[2]]]}, {d, data[[;; ;; \
3]]}],
 TableHeadings -> {None, {\"\[Alpha]\", \"A (Monte Carlo)\", \"A (van de \
Hulst)\", \"\[CapitalDelta]\"}}]\
\>", "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"891f4dbf-50c8-4683-b7f4-7947d22268d9"],

