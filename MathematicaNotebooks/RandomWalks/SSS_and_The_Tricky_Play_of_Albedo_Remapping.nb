Cell[CellGroupData[{

Cell["5. A pinch of Rayleigh", "Section",
 CellChangeTimes->{{4.003405751771069*^9, 
  4.0034057518261647`*^9}},ExpressionUUID->"6d3c1284-26b2-4b72-b14d-\
b92e8258455b"],

Cell[CellGroupData[{

Cell["\<\
(* 1/lambda^4 across the visible range, normalized to green = 540 nm; Adobe's \
RGB wavelengths marked *)
lambdaRGB = {640., 540., 460.};
rayleigh[l_] := (540./l)^4;

Show[
 Plot[rayleigh[l], {l, 380, 750}, Frame -> True, ImageSize -> 550,
  ColorFunction -> (ColorData[\"VisibleSpectrum\"][#1] &), \
ColorFunctionScaling -> False,
  Filling -> Axis, PlotStyle -> Thick, PlotRange -> {0, 4.5},
  FrameLabel -> {\"\[Lambda] (nm)\", \"scattering relative to 540 nm\"}],
 ListPlot[Transpose[{lambdaRGB, rayleigh /@ lambdaRGB}],
  PlotStyle -> Directive[Black, PointSize[Large]]]]\
\>", "Input",
 CellLabel->
  "In[110]:=",ExpressionUUID->"0c214e3b-cc7d-4be5-a362-fbfeb16113f0"],

