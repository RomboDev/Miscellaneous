Cell["\<\
Slide them: Adobe scales red and blue extinction around green (negative \
values tint the other way), Framestore blends gray Mie scattering into \
Rayleigh. Swatches show the per-channel scattering emphasis.\
\>", "Text",ExpressionUUID->"74272dc3-5e0c-4ee3-b056-688b5278b68c"],

Cell[CellGroupData[{

Cell["\<\
swatchN[v_] := Graphics[{RGBColor @@ (v/Max[v]), Rectangle[]}, ImageSize -> \
60];

Manipulate[
 With[{adobe = {1 + (adobeScale[[1]] - 1) t, 1., 1 + (adobeScale[[3]] - 1) t},
   frame = framestoreR w + (1 - w)},
  Grid[{
    {\"Adobe extinction scale\", BarChart[adobe, ChartStyle -> {Red, Green, \
Blue}, PlotRange -> {0, 3}, ImageSize -> 220],
     swatchN[adobe]},
    {\"Framestore scattering s\", BarChart[frame, ChartStyle -> {Red, Green, \
Blue}, PlotRange -> {0, 3}, ImageSize -> 220],
     swatchN[frame]}}, Alignment -> {Left, Center}]],
 {{t, 1., \"Adobe rayleigh\"}, -1., 1., Appearance -> \"Labeled\"},
 {{w, 0.64, \"Framestore w\"}, 0., 1., Appearance -> \"Labeled\"}]\
\>", "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"c4ba2697-3768-484f-a754-075115b59e0a"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`t$$ = 1., $CellContext`w$$ = 0.64, 
    Typeset`show$$ = True, Typeset`bookmarkList$$ = {}, 
    Typeset`bookmarkMode$$ = "Menu", Typeset`animator$$, Typeset`animvar$$ = 
    1, Typeset`name$$ = "\"untitled\"", Typeset`specs$$ = {{{
       Hold[$CellContext`t$$], 1., "Adobe rayleigh"}, -1., 1.}, {{
       Hold[$CellContext`w$$], 0.64, "Framestore w"}, 0., 1.}}, 
    Typeset`size$$ = {457., {132.5, 138.5}}, Typeset`update$$ = 0, 
    Typeset`initDone$$, Typeset`skipInitDone$$ = True}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`t$$ = 1., $CellContext`w$$ = 0.64}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> 
      With[{$CellContext`adobe = {
          1 + (Part[$CellContext`adobeScale, 1] - 1) $CellContext`t$$, 1., 
           1 + (Part[$CellContext`adobeScale, 3] - 
             1) $CellContext`t$$}, $CellContext`frame = \
$CellContext`framestoreR $CellContext`w$$ + (1 - $CellContext`w$$)}, 
        Grid[{{"Adobe extinction scale", 
           
           BarChart[$CellContext`adobe, ChartStyle -> {Red, Green, Blue}, 
            PlotRange -> {0, 3}, ImageSize -> 220], 
           $CellContext`swatchN[$CellContext`adobe]}, {
          "Framestore scattering s", 
           
           BarChart[$CellContext`frame, ChartStyle -> {Red, Green, Blue}, 
            PlotRange -> {0, 3}, ImageSize -> 220], 
           $CellContext`swatchN[$CellContext`frame]}}, 
         Alignment -> {Left, Center}]], 
      "Specifications" :> {{{$CellContext`t$$, 1., "Adobe rayleigh"}, -1., 1.,
          Appearance -> "Labeled"}, {{$CellContext`w$$, 0.64, "Framestore w"},
          0., 1., Appearance -> "Labeled"}}, "Options" :> {}, 
      "DefaultOptions" :> {}],
     ImageSizeCache->{506., {193., 199.}},
     SingleEvaluation->True],
