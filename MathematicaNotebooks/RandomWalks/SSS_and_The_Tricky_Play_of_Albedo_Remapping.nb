Cell[CellGroupData[{

Cell["Checks", "Subsection",ExpressionUUID->"f0c26bd2-172a-42aa-bbd9-eed80f434ac9"],

Cell[CellGroupData[{

Cell["\<\
(* both strategies are unbiased: means over many samples match the exact \
per-channel values *)
With[{st = sigmaTOf[10.], d = 2., n = 10^5},
 TableForm[{exactCh[st, d], Mean[Table[estRed[st, d], {n}]], \
Mean[Table[estMIS[st, d], {n}]]},
  TableHeadings -> {{\"exact\", \"A: red's \[Sigma]t\", \"B: MIS\"}, \
{\"red\", \"green\", \"blue\"}}]]\
\>", "Input",
 CellLabel->
  "In[108]:=",ExpressionUUID->"130c8a41-0148-4e23-a708-63503fa4dca3"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      StyleBox["\[Null]",
       ShowStringCharacters->False], 
      TagBox["\<\"red\"\>",
       HoldForm], 
      TagBox["\<\"green\"\>",
       HoldForm], 
      TagBox["\<\"blue\"\>",
       HoldForm]},
     {
      TagBox["\<\"exact\"\>",
       HoldForm], "0.7781982450870486`", "0.7985665897328724`", 
      "0.6999999985571924`"},
