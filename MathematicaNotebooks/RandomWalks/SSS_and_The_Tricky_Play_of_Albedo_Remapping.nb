Cell["\<\
(* Pixar (Wrenninge, Villemin, Hery 2017): six coefficients, each a degree-7 \
polynomial in g *)
(* kB, kE: for g < 0 the exponent dives to about -1150, the term is just 0 \
(fit made for g >= 0); expU flushes it to 0 like expf in C *)
expU[x_] := If[x < -700., 0., Exp[x]];
kA[g_] := 1.8260523782 - 1.28451056436 g - 1.79904629312 g^2 + 9.19393289202 \
g^3 - 22.8215585862 g^4 + 32.0234874259 g^5 - 23.6264803333 g^6 + \
7.21067002658 g^7;
kB[g_] := 4.98511194385 + 0.127355959438 expU[31.1491581433 g - 201.847017512 \
g^2 + 841.576016723 g^3 - 2018.09288505 g^4 + 2731.71560286 g^5 - \
1935.41424244 g^6 + 559.009054474 g^7];
kC[g_] := 1.09686102424 - 0.394704063468 g + 1.05258115941 g^2 - \
8.83963712726 g^3 + 28.8643230661 g^4 - 46.8802913581 g^5 + 38.5402837518 g^6 \
- 12.7181042538 g^7;
kD[g_] := 0.496310210422 + 0.360146581622 g - 2.15139309747 g^2 + \
17.8896899217 g^3 - 55.2984010333 g^4 + 82.065982243 g^5 - 58.5106008578 g^6 \
+ 15.8478295021 g^7;
kE[g_] := 4.23190299701 + 0.00310603949088 expU[76.7316253952 g - \
594.356773233 g^2 + 2448.8834203 g^3 - 5576.68528998 g^4 + 7116.60171912 g^5 \
- 4763.54467887 g^6 + 1303.5318055 g^7];
kF[g_] := 2.40602999408 - 2.51814844609 g + 9.18494908356 g^2 - 79.2191708682 \
g^3 + 259.082868209 g^4 - 403.613804597 g^5 + 302.85712436 g^6 - \
87.4370473567 g^7;

alphaPixarRaw[A_, g_] := With[{b = A^0.25},
   (1 - b) kA[g] ArcTan[kB[g] A]^kC[g] + b kD[g] ArcTan[kE[g] A]^kF[g]];
alphaPixar[A_, g_] := Clip[alphaPixarRaw[A, g], {0., 0.999999}];   (* as \
shipped *)

(* alphaChiang[A] and alphaVdH[A, g] come from section 2 *)\
\>", "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"a0c96b63-03a4-465a-9a55-947a69fe087f"],

Cell["\<\
Drag g: Imageworks and Pixar bend with it, Disney doesn't move.\
\>", "Text",ExpressionUUID->"059f9e96-15a0-41b9-ab8a-e75e49a80534"],

Cell[CellGroupData[{

Cell["\<\
Manipulate[
 Plot[{alphaChiang[A], alphaVdH[A, g], alphaPixar[A, g]}, {A, 0, 1},
  PlotRange -> {0, 1}, Frame -> True, AspectRatio -> 1, ImageSize -> 450,
  PlotStyle -> {Thick, Directive[Thick, Orange], Directive[Thick, Dashed, \
Green]},
  PlotLegends -> {\"Disney\", \"Imageworks\", \"Pixar\"},
  FrameLabel -> {\"A\", \"\[Alpha]\"}],
 {{g, 0., \"g\"}, -0.5, 0.95, Appearance -> \"Labeled\"}]\
\>", "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"a3703d94-6e78-43ba-8bac-edf45b173c96"],

