 PlotStyle -> {Directive[Thick, Orange], Directive[Thick, Dashed, Green]},
 PlotLegends -> {\"Imageworks\", \"Pixar (raw fit)\"},
 GridLines -> {{0}, {0, 1}}, FrameLabel -> {\"g\", \"\[Alpha]\"}]\
\>", "Input",
